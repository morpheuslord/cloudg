<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CloudMapper Security Report</title>
    <meta name="description" content="Cloud Infrastructure Security Assessment Report generated by CloudMapper">
    <style>
        /* ── Reset & Base ── */
        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

        :root {
            --bg-primary: #0F172A;
            --bg-secondary: #1E293B;
            --bg-tertiary: #334155;
            --text-primary: #F8FAFC;
            --text-secondary: #CBD5E1;
            --text-muted: #94A3B8;
            --border: #334155;
            --accent: #6366F1;
            --accent-hover: #4F46E5;
            --critical: #EF4444;
            --high: #F97316;
            --medium: #EAB308;
            --low: #3498DB;
            --info: #64748B;
            --success: #22C55E;
            --radius: 12px;
            --shadow: 0 4px 6px -1px rgba(0,0,0,0.3), 0 2px 4px -2px rgba(0,0,0,0.2);
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background: var(--bg-primary);
            color: var(--text-secondary);
            line-height: 1.6;
        }

        /* ── Layout ── */
        .container { max-width: 1500px; margin: 0 auto; padding: 24px; }

        .header {
            display: flex; justify-content: space-between; align-items: center;
            padding: 24px 0; border-bottom: 1px solid var(--border); margin-bottom: 30px;
        }
        .header h1 { font-size: 28px; color: var(--text-primary); font-weight: 700; }
        .header .meta { color: var(--text-muted); font-size: 13px; }

        /* ── Cards Grid ── */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 16px; margin-bottom: 32px;
        }
        .stat-card {
            background: var(--bg-secondary); border: 1px solid var(--border);
            border-radius: var(--radius); padding: 20px;
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .stat-card:hover { transform: translateY(-2px); box-shadow: var(--shadow); }
        .stat-card .label {
            font-size: 11px; text-transform: uppercase; letter-spacing: 1.5px;
            color: var(--text-muted); margin-bottom: 8px;
        }
        .stat-card .value { font-size: 32px; font-weight: 800; color: var(--text-primary); }
        .stat-card.critical .value { color: var(--critical); }
        .stat-card.high .value { color: var(--high); }
        .stat-card.medium .value { color: var(--medium); }
        .stat-card.low .value { color: var(--low); }

        /* ── Tabs ── */
        .tabs {
            display: flex; gap: 4px; margin-bottom: 24px;
            background: var(--bg-secondary); border-radius: var(--radius);
            padding: 4px; border: 1px solid var(--border);
        }
        .tab {
            padding: 10px 20px; border-radius: 8px; cursor: pointer;
            font-size: 14px; font-weight: 500; color: var(--text-muted);
            transition: all 0.2s; border: none; background: none;
        }
        .tab:hover { color: var(--text-primary); background: var(--bg-tertiary); }
        .tab.active { background: var(--accent); color: white; }

        .tab-content { display: none; }
        .tab-content.active { display: block; }

        /* ── Charts ── */
        .charts-row {
            display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 30px;
        }
        .chart-card {
            background: var(--bg-secondary); border: 1px solid var(--border);
            border-radius: var(--radius); padding: 24px;
        }
        .chart-card h3 { color: var(--text-primary); font-size: 16px; margin-bottom: 16px; }
        .chart-card canvas { max-height: 300px; }

        /* ── Topology ── */
        #topology-container {
            background: var(--bg-secondary); border: 1px solid var(--border);
            border-radius: var(--radius); overflow: hidden; min-height: 500px;
        }
        #topology-container svg { width: 100%; height: 500px; }

        /* ── Findings Table ── */
        .table-controls {
            display: flex; gap: 12px; margin-bottom: 16px; flex-wrap: wrap;
        }
        .table-controls select, .table-controls input {
            background: var(--bg-secondary); border: 1px solid var(--border);
            color: var(--text-secondary); padding: 8px 14px; border-radius: 8px;
            font-size: 14px; outline: none;
        }
        .table-controls select:focus, .table-controls input:focus {
            border-color: var(--accent);
        }

        table { width: 100%; border-collapse: collapse; }
        thead { background: var(--bg-tertiary); }
        th {
            padding: 12px 16px; text-align: left; font-size: 11px;
            text-transform: uppercase; letter-spacing: 1px; color: var(--text-muted);
            font-weight: 600;
        }
        td {
            padding: 12px 16px; border-bottom: 1px solid var(--border);
            font-size: 14px; vertical-align: top;
        }
        tr { transition: background 0.15s; cursor: pointer; }
        tr:hover { background: var(--bg-tertiary); }

        .severity-badge {
            display: inline-block; padding: 2px 10px; border-radius: 20px;
            font-size: 11px; font-weight: 700; text-transform: uppercase;
        }
        .severity-CRITICAL { background: rgba(239,68,68,0.15); color: var(--critical); }
        .severity-HIGH { background: rgba(249,115,22,0.15); color: var(--high); }
        .severity-MEDIUM { background: rgba(234,179,8,0.15); color: var(--medium); }
        .severity-LOW { background: rgba(52,152,219,0.15); color: var(--low); }
        .severity-INFO { background: rgba(100,116,139,0.15); color: var(--info); }

        code { background: var(--bg-tertiary); padding: 2px 6px; border-radius: 4px; font-size: 12px; }

        /* ── Detail Panel ── */
        .detail-panel {
            display: none; position: fixed; top: 0; right: 0;
            width: 500px; height: 100vh; background: var(--bg-secondary);
            border-left: 1px solid var(--border); z-index: 1000;
            overflow-y: auto; padding: 24px; box-shadow: -4px 0 20px rgba(0,0,0,0.4);
        }
        .detail-panel.open { display: block; }
        .detail-panel .close-btn {
            position: absolute; top: 16px; right: 16px;
            background: var(--bg-tertiary); border: none; color: var(--text-secondary);
            width: 32px; height: 32px; border-radius: 8px; cursor: pointer;
            font-size: 18px; display: flex; align-items: center; justify-content: center;
        }
        .detail-panel h2 { font-size: 18px; color: var(--text-primary); margin-bottom: 20px; padding-right: 40px; }
        .detail-field { margin-bottom: 16px; }
        .detail-field .label { font-size: 11px; text-transform: uppercase; letter-spacing: 1px; color: var(--text-muted); margin-bottom: 4px; }
        .detail-field .value { color: var(--text-secondary); font-size: 14px; }
        .detail-field pre { background: var(--bg-primary); padding: 12px; border-radius: 8px; font-size: 12px; overflow-x: auto; color: var(--text-secondary); }

        /* ── Compliance ── */
        .compliance-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 16px; }
        .compliance-card {
            background: var(--bg-secondary); border: 1px solid var(--border);
            border-radius: var(--radius); padding: 20px;
        }
        .compliance-card h4 { color: var(--text-primary); margin-bottom: 12px; }
        .compliance-bar { height: 8px; background: var(--bg-tertiary); border-radius: 4px; overflow: hidden; margin-top: 8px; }
        .compliance-bar-fill { height: 100%; border-radius: 4px; transition: width 0.8s ease; }

        /* ── Export Button ── */
        .btn-export {
            background: var(--accent); color: white; border: none;
            padding: 10px 20px; border-radius: 8px; cursor: pointer;
            font-weight: 600; font-size: 14px; transition: background 0.2s;
        }
        .btn-export:hover { background: var(--accent-hover); }

        @media (max-width: 768px) {
            .charts-row { grid-template-columns: 1fr; }
            .header { flex-direction: column; align-items: flex-start; gap: 12px; }
            .detail-panel { width: 100%; }
        }
    </style>
    <!-- Chart.js 4 (self-contained) -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <!-- D3.js v7 -->
    <script src="https://cdn.jsdelivr.net/npm/d3@7/dist/d3.min.js"></script>
</head>
<body>

<div class="container">
    <!-- Header -->
    <div class="header">
        <div>
            <h1>☁️ CloudMapper Security Report</h1>
            <p class="meta">Scan: {{ scan_id }} &middot; Provider: {{ provider }} &middot; Account: {{ account_id }} &middot; {{ started_at }}</p>
        </div>
        <button class="btn-export" onclick="exportJSON()">⬇ Export JSON</button>
    </div>

    <!-- Stats Cards -->
    <div class="stats-grid">
        <div class="stat-card"><div class="label">Total Assets</div><div class="value">{{ total_assets }}</div></div>
        <div class="stat-card"><div class="label">Total Findings</div><div class="value">{{ total_findings }}</div></div>
        <div class="stat-card critical"><div class="label">Critical</div><div class="value">{{ severity_counts.CRITICAL }}</div></div>
        <div class="stat-card high"><div class="label">High</div><div class="value">{{ severity_counts.HIGH }}</div></div>
        <div class="stat-card medium"><div class="label">Medium</div><div class="value">{{ severity_counts.MEDIUM }}</div></div>
        <div class="stat-card low"><div class="label">Low</div><div class="value">{{ severity_counts.LOW }}</div></div>
    </div>

    <!-- Tabs -->
    <div class="tabs" id="main-tabs">
        <button class="tab active" onclick="switchTab('topology')">Topology Map</button>
        <button class="tab" onclick="switchTab('findings')">Findings</button>
        <button class="tab" onclick="switchTab('charts')">Analytics</button>
        <button class="tab" onclick="switchTab('compliance')">Compliance</button>
    </div>

    <!-- Tab: Topology -->
    <div class="tab-content active" id="tab-topology">
        <div id="topology-container"></div>
    </div>

    <!-- Tab: Findings -->
    <div class="tab-content" id="tab-findings">
        <div class="table-controls">
            <select id="filter-severity" onchange="filterFindings()">
                <option value="">All Severities</option>
                <option value="CRITICAL">Critical</option>
                <option value="HIGH">High</option>
                <option value="MEDIUM">Medium</option>
                <option value="LOW">Low</option>
                <option value="INFO">Info</option>
            </select>
            <select id="filter-source" onchange="filterFindings()">
                <option value="">All Sources</option>
            </select>
            <input type="text" id="filter-search" placeholder="Search findings..." oninput="filterFindings()">
        </div>
        <table>
            <thead>
                <tr>
                    <th>Severity</th>
                    <th>Title</th>
                    <th>Resource</th>
                    <th>Source</th>
                    <th>Risk Score</th>
                </tr>
            </thead>
            <tbody id="findings-body"></tbody>
        </table>
    </div>

    <!-- Tab: Charts -->
    <div class="tab-content" id="tab-charts">
        <div class="charts-row">
            <div class="chart-card">
                <h3>Severity Distribution</h3>
                <canvas id="chart-severity"></canvas>
            </div>
            <div class="chart-card">
                <h3>Resource Types</h3>
                <canvas id="chart-resources"></canvas>
            </div>
        </div>
        <div class="charts-row">
            <div class="chart-card">
                <h3>Findings by Source</h3>
                <canvas id="chart-sources"></canvas>
            </div>
            <div class="chart-card">
                <h3>Compliance Overview</h3>
                <canvas id="chart-compliance"></canvas>
            </div>
        </div>
    </div>

    <!-- Tab: Compliance -->
    <div class="tab-content" id="tab-compliance">
        <div class="compliance-grid" id="compliance-grid"></div>
    </div>
</div>

<!-- Detail Panel -->
<div class="detail-panel" id="detail-panel">
    <button class="close-btn" onclick="closeDetail()">&times;</button>
    <div id="detail-content"></div>
</div>

<script>
    // ── Data ──
    const graphData = {{ graph_json|safe }};
    const findingsData = {{ findings_json|safe }};
    const severityCounts = {{ severity_counts_json|safe }};
    const resourceTypes = {{ resource_types_json|safe }};
    const sourceTools = {{ source_tools_json|safe }};
    const complianceSummary = {{ compliance_summary_json|safe }};

    // ── Tab Switching ──
    function switchTab(tabId) {
        document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
        document.querySelectorAll('.tab').forEach(el => el.classList.remove('active'));
        document.getElementById('tab-' + tabId).classList.add('active');
        event.target.classList.add('active');
        if (tabId === 'topology') renderTopology();
    }

    // ── Findings Table ──
    function renderFindings(data) {
        const tbody = document.getElementById('findings-body');
        tbody.innerHTML = data.map((f, i) => `
            <tr onclick="showDetail(${i})">
                <td><span class="severity-badge severity-${f.severity}">${f.severity}</span></td>
                <td>${f.title}</td>
                <td><code>${f.resource_arn || f.resource_id || ''}</code></td>
                <td>${f.source_tool}</td>
                <td>${f.risk_score || '-'}</td>
            </tr>
        `).join('');
    }

    function filterFindings() {
        const severity = document.getElementById('filter-severity').value;
        const source = document.getElementById('filter-source').value;
        const search = document.getElementById('filter-search').value.toLowerCase();
        let filtered = findingsData;
        if (severity) filtered = filtered.filter(f => f.severity === severity);
        if (source) filtered = filtered.filter(f => f.source_tool === source);
        if (search) filtered = filtered.filter(f =>
            f.title.toLowerCase().includes(search) ||
            (f.resource_arn || '').toLowerCase().includes(search) ||
            (f.description || '').toLowerCase().includes(search)
        );
        renderFindings(filtered);
    }

    // Populate source filter
    const sourceSelect = document.getElementById('filter-source');
    Object.keys(sourceTools).forEach(tool => {
        const opt = document.createElement('option');
        opt.value = tool; opt.textContent = tool;
        sourceSelect.appendChild(opt);
    });

    // ── Detail Panel ──
    function showDetail(index) {
        const f = findingsData[index];
        const panel = document.getElementById('detail-panel');
        const content = document.getElementById('detail-content');
        content.innerHTML = `
            <h2>${f.title}</h2>
            <div class="detail-field"><div class="label">Severity</div><div class="value"><span class="severity-badge severity-${f.severity}">${f.severity}</span></div></div>
            <div class="detail-field"><div class="label">Resource</div><div class="value"><code>${f.resource_arn || f.resource_id || 'N/A'}</code></div></div>
            <div class="detail-field"><div class="label">Description</div><div class="value">${f.description || 'N/A'}</div></div>
            <div class="detail-field"><div class="label">Evidence</div><div class="value"><pre>${f.evidence || 'N/A'}</pre></div></div>
            <div class="detail-field"><div class="label">Remediation</div><div class="value">${f.remediation || 'N/A'}</div></div>
            <div class="detail-field"><div class="label">Source Tool</div><div class="value">${f.source_tool}</div></div>
            <div class="detail-field"><div class="label">CVSS Score</div><div class="value">${f.cvss_score || 'N/A'}</div></div>
            <div class="detail-field"><div class="label">Compliance Frameworks</div><div class="value">${(f.compliance_frameworks || []).join(', ') || 'N/A'}</div></div>
            <div class="detail-field"><div class="label">Risk Score</div><div class="value">${f.risk_score || 'N/A'}</div></div>
        `;
        panel.classList.add('open');
    }
    function closeDetail() { document.getElementById('detail-panel').classList.remove('open'); }

    // ── D3 Topology ──
    function renderTopology() {
        const container = document.getElementById('topology-container');
        container.innerHTML = '';
        const width = container.clientWidth || 1200;
        const height = 500;

        if (!graphData.nodes || graphData.nodes.length === 0) {
            container.innerHTML = '<p style="padding:40px;text-align:center;color:var(--text-muted)">No topology data available. Run a collection first.</p>';
            return;
        }

        const svg = d3.select(container).append('svg').attr('width', width).attr('height', height);
        const g = svg.append('g');

        svg.call(d3.zoom().scaleExtent([0.2, 5]).on('zoom', (e) => g.attr('transform', e.transform)));

        const typeColors = {
            EC2: '#FF9900', VIRTUAL_MACHINE: '#FF9900', GCE_INSTANCE: '#FF9900',
            VPC: '#4A90D9', VNET: '#4A90D9',
            SUBNET: '#7EC8E3',
            RDS_INSTANCE: '#3B48CC', AURORA_CLUSTER: '#3B48CC', AZURE_SQL: '#3B48CC', CLOUD_SQL: '#3B48CC',
            S3_BUCKET: '#569A31', BLOB_STORAGE: '#569A31', GCS_BUCKET: '#569A31',
            SECURITY_GROUP: '#DD4B39', NSG: '#DD4B39',
            LOAD_BALANCER: '#8C4FFF',
            IAM_USER: '#232F3E', IAM_ROLE: '#232F3E',
            LAMBDA_FUNCTION: '#FF9900', CLOUD_FUNCTION: '#FF9900',
        };

        const sim = d3.forceSimulation(graphData.nodes)
            .force('link', d3.forceLink(graphData.links).id(d => d.id).distance(100))
            .force('charge', d3.forceManyBody().strength(-200))
            .force('center', d3.forceCenter(width / 2, height / 2))
            .force('collision', d3.forceCollide().radius(30));

        const link = g.append('g').selectAll('line').data(graphData.links).join('line')
            .attr('stroke', d => d.cidr === '0.0.0.0/0' ? '#E74C3C' : '#555')
            .attr('stroke-width', d => d.cidr === '0.0.0.0/0' ? 2 : 1)
            .attr('stroke-opacity', 0.5);

        const node = g.append('g').selectAll('g').data(graphData.nodes).join('g')
            .call(d3.drag().on('start', dragstarted).on('drag', dragged).on('end', dragended));

        node.append('circle').attr('r', d => d.is_external ? 8 : 16)
            .attr('fill', d => typeColors[d.type] || '#95A5A6')
            .attr('stroke', d => d.is_internet_exposed ? '#FF0000' : '#fff')
            .attr('stroke-width', d => d.is_internet_exposed ? 3 : 1.5);

        node.append('text').text(d => d.name ? d.name.substring(0, 15) : d.id.substring(0, 10))
            .attr('dy', 28).attr('text-anchor', 'middle')
            .attr('fill', '#CBD5E1').attr('font-size', '10px');

        node.append('title').text(d => `${d.type}: ${d.name}\nRegion: ${d.region}\nARN: ${d.arn || 'N/A'}`);

        sim.on('tick', () => {
            link.attr('x1', d => d.source.x).attr('y1', d => d.source.y)
                .attr('x2', d => d.target.x).attr('y2', d => d.target.y);
            node.attr('transform', d => `translate(${d.x},${d.y})`);
        });

        function dragstarted(e, d) { if (!e.active) sim.alphaTarget(0.3).restart(); d.fx = d.x; d.fy = d.y; }
        function dragged(e, d) { d.fx = e.x; d.fy = e.y; }
        function dragended(e, d) { if (!e.active) sim.alphaTarget(0); d.fx = null; d.fy = null; }
    }

    // ── Chart.js Charts ──
    function renderCharts() {
        // Severity Donut
        new Chart(document.getElementById('chart-severity'), {
            type: 'doughnut',
            data: {
                labels: Object.keys(severityCounts),
                datasets: [{
                    data: Object.values(severityCounts),
                    backgroundColor: ['#EF4444', '#F97316', '#EAB308', '#3498DB', '#64748B'],
                    borderWidth: 0, hoverOffset: 8,
                }]
            },
            options: {
                responsive: true, plugins: { legend: { position: 'bottom', labels: { color: '#CBD5E1' } } },
                cutout: '65%',
            }
        });

        // Resource Types Bar
        new Chart(document.getElementById('chart-resources'), {
            type: 'bar',
            data: {
                labels: Object.keys(resourceTypes),
                datasets: [{
                    data: Object.values(resourceTypes),
                    backgroundColor: '#6366F1', borderRadius: 6,
                }]
            },
            options: {
                responsive: true, indexAxis: 'y',
                plugins: { legend: { display: false } },
                scales: {
                    x: { ticks: { color: '#94A3B8' }, grid: { color: '#1E293B' } },
                    y: { ticks: { color: '#CBD5E1' }, grid: { display: false } },
                },
            }
        });

        // Sources Donut
        new Chart(document.getElementById('chart-sources'), {
            type: 'doughnut',
            data: {
                labels: Object.keys(sourceTools),
                datasets: [{
                    data: Object.values(sourceTools),
                    backgroundColor: ['#6366F1', '#8B5CF6', '#EC4899', '#14B8A6', '#F97316', '#EAB308'],
                    borderWidth: 0,
                }]
            },
            options: {
                responsive: true, plugins: { legend: { position: 'bottom', labels: { color: '#CBD5E1' } } },
                cutout: '65%',
            }
        });

        // Compliance
        const fws = Object.keys(complianceSummary);
        const passData = fws.map(fw => complianceSummary[fw]?.pass || 0);
        const failData = fws.map(fw => complianceSummary[fw]?.fail || 0);
        new Chart(document.getElementById('chart-compliance'), {
            type: 'bar',
            data: {
                labels: fws,
                datasets: [
                    { label: 'Pass', data: passData, backgroundColor: '#22C55E', borderRadius: 4 },
                    { label: 'Fail', data: failData, backgroundColor: '#EF4444', borderRadius: 4 },
                ]
            },
            options: {
                responsive: true,
                plugins: { legend: { labels: { color: '#CBD5E1' } } },
                scales: {
                    x: { ticks: { color: '#CBD5E1' }, grid: { display: false }, stacked: true },
                    y: { ticks: { color: '#94A3B8' }, grid: { color: '#1E293B' }, stacked: true },
                },
            }
        });
    }

    // ── Compliance Grid ──
    function renderCompliance() {
        const grid = document.getElementById('compliance-grid');
        grid.innerHTML = Object.entries(complianceSummary).map(([fw, data]) => {
            const total = (data.pass || 0) + (data.fail || 0);
            const pct = total > 0 ? Math.round((data.pass / total) * 100) : 0;
            const barColor = pct >= 80 ? 'var(--success)' : pct >= 50 ? 'var(--medium)' : 'var(--critical)';
            return `
                <div class="compliance-card">
                    <h4>${fw}</h4>
                    <div style="display:flex;justify-content:space-between;color:var(--text-muted);font-size:13px">
                        <span>Pass: ${data.pass || 0}</span><span>Fail: ${data.fail || 0}</span><span>${pct}%</span>
                    </div>
                    <div class="compliance-bar">
                        <div class="compliance-bar-fill" style="width:${pct}%;background:${barColor}"></div>
                    </div>
                </div>
            `;
        }).join('');
    }

    // ── Export ──
    function exportJSON() {
        const blob = new Blob([JSON.stringify({findings: findingsData, graph: graphData}, null, 2)], {type: 'application/json'});
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = 'findings.json';
        a.click();
    }

    // ── Init ──
    renderFindings(findingsData);
    renderTopology();
    renderCharts();
    renderCompliance();
</script>

</body>
</html>
