<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="dark light">
    <meta name="generator" content="cloudg {{ summary.version }}">
    <title>cloudg security report · {{ account_id }}</title>
    <style>
        :root {
            --bg: #0a0c0f; --surface: #101318; --surface-2: #151920; --surface-3: #1b2029;
            --line: #222832; --line-strong: #2e3542;
            --text: #c3cad4; --strong: #eef2f6; --muted: #7b8594; --faint: #4b5361;
            --accent: #22d3ee; --accent-ink: #041016; --accent-soft: rgba(34, 211, 238, .12);
            --critical: #ff5a5f; --high: #ff9447; --medium: #f2c14e; --low: #5aa9ff; --info: #8b95a5;
            --pass: #3ccf8e; --fail: #ff5a5f;
            --f-exposure: #ff5a5f; --f-network: #22d3ee; --f-identity: #f2b84b; --f-data: #a78bfa; --f-governance: #3ccf8e;
            --radius: 10px; --radius-sm: 6px;
            --mono: ui-monospace, "SF Mono", "JetBrains Mono", Menlo, Consolas, monospace;
            --sans: -apple-system, BlinkMacSystemFont, "Inter", "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            --shadow: 0 1px 0 rgba(255,255,255,.03) inset, 0 0 0 1px var(--line), 0 12px 32px -18px rgba(0,0,0,.6);
            color-scheme: dark;
        }
        :root[data-theme="light"] {
            --bg: #f4f4f1; --surface: #fbfbfa; --surface-2: #ffffff; --surface-3: #f0f0ec;
            --line: #e2e2dd; --line-strong: #cfcfc8;
            --text: #3d4148; --strong: #111316; --muted: #6c727c; --faint: #a3a8b0;
            --accent: #0891b2; --accent-ink: #ffffff; --accent-soft: rgba(8, 145, 178, .10);
            --critical: #d63b40; --high: #d9661c; --medium: #b98710; --low: #2f6fd1; --info: #6c727c;
            --pass: #1f9d63; --fail: #d63b40;
            --f-exposure: #d63b40; --f-network: #0891b2; --f-identity: #b7791f; --f-data: #7c5cd6; --f-governance: #1f9d63;
            --shadow: 0 0 0 1px var(--line), 0 10px 28px -20px rgba(0,0,0,.25);
            color-scheme: light;
        }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        html { background: var(--bg); }
        body { font-family: var(--sans); background: var(--bg); color: var(--text); line-height: 1.55; font-size: 14px; -webkit-font-smoothing: antialiased; }
        a { color: var(--accent); }
        code, pre, .mono { font-family: var(--mono); }
        button { font: inherit; color: inherit; }
        :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

        /* ── Top bar ── */
        .topbar { position: sticky; top: 0; z-index: 30; display: flex; align-items: center; gap: 16px; padding: 10px 28px; background: color-mix(in srgb, var(--bg) 86%, transparent); backdrop-filter: blur(10px); border-bottom: 1px solid var(--line); }
        .brand { display: flex; align-items: center; gap: 10px; color: var(--strong); font-weight: 650; letter-spacing: -.01em; }
        .brand svg { width: 22px; height: 22px; }
        .brand .sep { width: 1px; height: 18px; background: var(--line-strong); }
        .brand small { font-weight: 500; color: var(--muted); font-size: 13px; }
        .topbar .spacer { flex: 1; }
        .btn { display: inline-flex; align-items: center; gap: 7px; height: 32px; padding: 0 12px; border-radius: var(--radius-sm); border: 1px solid var(--line-strong); background: var(--surface-2); color: var(--text); font-size: 13px; cursor: pointer; white-space: nowrap; transition: border-color .15s, background .15s, color .15s; }
        .btn:hover { border-color: var(--accent); color: var(--strong); }
        .btn.primary { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); font-weight: 600; }
        .btn.icon { width: 32px; padding: 0; justify-content: center; }
        .btn svg { width: 15px; height: 15px; }
        .btn[aria-pressed="true"] { background: var(--accent-soft); border-color: var(--accent); color: var(--strong); }

        .page { max-width: 1440px; margin: 0 auto; padding: 28px 28px 64px; }

        /* ── Overview ── */
        .eyebrow { font-family: var(--mono); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--accent); }
        .overview { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr); gap: 20px; margin-bottom: 22px; }
        .card { background: var(--surface); border-radius: var(--radius); box-shadow: var(--shadow); }
        .hero { padding: 26px 28px; display: flex; flex-direction: column; gap: 20px; }
        .hero h1 { font-size: 30px; line-height: 1.15; letter-spacing: -.02em; color: var(--strong); font-weight: 680; margin-top: 6px; }
        .hero .lede { color: var(--muted); max-width: 64ch; }
        .hero .lede strong { color: var(--strong); font-weight: 600; }
        .meta { display: flex; flex-wrap: wrap; gap: 8px; }
        .chip { display: inline-flex; align-items: center; gap: 6px; height: 26px; padding: 0 10px; border-radius: 999px; background: var(--surface-3); border: 1px solid var(--line); font-size: 12px; color: var(--muted); max-width: 100%; }
        .chip b { color: var(--text); font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .kpis { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1px; background: var(--line); border-radius: var(--radius-sm); overflow: hidden; border: 1px solid var(--line); }
        .kpi { background: var(--surface); padding: 14px 16px; }
        .kpi .k { font-family: var(--mono); font-size: 10.5px; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); display: flex; align-items: center; gap: 6px; }
        .kpi .v { font-size: 26px; font-weight: 680; color: var(--strong); letter-spacing: -.02em; font-variant-numeric: tabular-nums; margin-top: 4px; }
        .kpi .s { font-size: 12px; color: var(--muted); }
        .dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; background: var(--sev, var(--muted)); flex: none; }
        .sev-CRITICAL { --sev: var(--critical); } .sev-HIGH { --sev: var(--high); } .sev-MEDIUM { --sev: var(--medium); } .sev-LOW { --sev: var(--low); } .sev-INFO { --sev: var(--info); }
        .sevbar { display: flex; height: 8px; border-radius: 999px; overflow: hidden; background: var(--surface-3); gap: 2px; }
        .sevbar span { background: var(--sev); min-width: 3px; }
        .sevlegend { display: flex; flex-wrap: wrap; gap: 6px 16px; margin-top: 10px; font-size: 12px; color: var(--muted); }
        .sevlegend span { display: inline-flex; align-items: center; gap: 6px; }
        .posture { padding: 22px 24px; display: flex; flex-direction: column; gap: 16px; }
        .posture-head { display: flex; align-items: center; gap: 18px; }
        .ring { width: 92px; height: 92px; flex: none; }
        .ring circle { fill: none; stroke-width: 7; }
        .ring .track { stroke: var(--surface-3); }
        .ring .val { stroke: var(--pass); stroke-linecap: round; transform: rotate(-90deg); transform-origin: 50% 50%; transition: stroke-dashoffset 1.2s cubic-bezier(.32,.72,0,1); }
        .ring text { fill: var(--strong); font-size: 20px; font-weight: 700; text-anchor: middle; font-family: var(--sans); }
        .posture h3 { font-size: 15px; color: var(--strong); font-weight: 620; }
        .posture p { color: var(--muted); font-size: 13px; }
        .risks { list-style: none; display: flex; flex-direction: column; gap: 6px; }
        .risk { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 10px; padding: 9px 12px; border-radius: var(--radius-sm); background: var(--surface-2); border: 1px solid var(--line); cursor: pointer; text-align: left; width: 100%; }
        .risk:hover { border-color: var(--line-strong); }
        .risk .t { color: var(--strong); font-size: 13px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .risk .r { color: var(--muted); font-size: 11.5px; font-family: var(--mono); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .risk .score { font-family: var(--mono); font-size: 12px; color: var(--muted); }

        /* ── Tabs ── */
        .tabs { display: flex; gap: 2px; border-bottom: 1px solid var(--line); margin: 8px 0 18px; overflow-x: auto; scrollbar-width: none; }
        .tab { position: relative; padding: 10px 14px 12px; background: none; border: 0; color: var(--muted); cursor: pointer; font-size: 13.5px; font-weight: 550; white-space: nowrap; display: inline-flex; gap: 8px; align-items: center; }
        .tab .count { font-family: var(--mono); font-size: 11px; color: var(--faint); }
        .tab:hover { color: var(--strong); }
        .tab.active { color: var(--strong); }
        .tab.active::after { content: ""; position: absolute; left: 10px; right: 10px; bottom: -1px; height: 2px; background: var(--accent); border-radius: 2px; }
        .tab-content { display: none; }
        .tab-content.active { display: block; animation: rise .35s cubic-bezier(.32,.72,0,1); }
        @keyframes rise { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }

        /* ── Map plate ── */
        .plate { position: relative; background: var(--surface); border-radius: var(--radius); box-shadow: var(--shadow); overflow: hidden; }
        .plate-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; padding: 12px 14px; border-bottom: 1px solid var(--line); background: var(--surface-2); }
        .seg { display: inline-flex; border: 1px solid var(--line-strong); border-radius: var(--radius-sm); overflow: hidden; }
        .seg button { height: 30px; padding: 0 12px; border: 0; background: transparent; color: var(--muted); cursor: pointer; font-size: 12.5px; font-weight: 600; }
        .seg button[aria-pressed="true"] { background: var(--accent-soft); color: var(--strong); }
        .seg button + button { border-left: 1px solid var(--line-strong); }
        .plate-bar .grow { flex: 1; }
        .search { position: relative; }
        .search input { height: 32px; width: 220px; padding: 0 10px 0 30px; border-radius: var(--radius-sm); border: 1px solid var(--line-strong); background: var(--surface); color: var(--strong); font-size: 13px; }
        .search svg { position: absolute; left: 9px; top: 9px; width: 14px; height: 14px; color: var(--muted); }
        .families { display: flex; flex-wrap: wrap; gap: 6px; padding: 10px 14px; border-bottom: 1px solid var(--line); }
        .fam { display: inline-flex; align-items: center; gap: 7px; height: 26px; padding: 0 10px; border-radius: 999px; border: 1px solid var(--line-strong); background: transparent; color: var(--muted); font-size: 12px; cursor: pointer; }
        .fam i { width: 14px; height: 2px; border-radius: 2px; background: var(--fam); }
        .fam[aria-pressed="true"] { color: var(--strong); border-color: var(--fam); background: color-mix(in srgb, var(--fam) 10%, transparent); }
        .fam .n { font-family: var(--mono); font-size: 11px; color: var(--faint); }
        .fam-exposure { --fam: var(--f-exposure); } .fam-network { --fam: var(--f-network); } .fam-identity { --fam: var(--f-identity); } .fam-data { --fam: var(--f-data); } .fam-governance { --fam: var(--f-governance); }
        .map-body { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) 320px; }
        .stage { position: relative; height: clamp(460px, 72vh, 800px); overflow: hidden; background:
            radial-gradient(circle at 50% 38%, color-mix(in srgb, var(--accent) 5%, transparent), transparent 60%),
            radial-gradient(var(--line) 0.8px, transparent 0.8px) 0 0 / 22px 22px;
            cursor: grab; touch-action: none; outline: none; }
        .stage.dragging { cursor: grabbing; }
        .corner { position: absolute; z-index: 2; font-family: var(--mono); font-size: 10.5px; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); pointer-events: none; }
        .corner.tl { top: 14px; left: 16px; color: var(--text); letter-spacing: .04em; }
        .corner.tr { top: 14px; right: 16px; }
        .corner.bl { bottom: 14px; left: 16px; }
        .corner.br { bottom: 14px; right: 16px; text-transform: none; letter-spacing: .02em; color: var(--text); font-variant-numeric: tabular-nums; max-width: 60%; text-align: right; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        #iso-svg { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
        #topology-container { position: absolute; inset: 0; display: none; }
        #topology-container svg { width: 100%; height: 100%; }
        .stage.flat #topology-container { display: block; }
        .stage.flat #iso-svg { display: none; }
        .map-note { position: absolute; inset: 0; display: grid; place-items: center; padding: 40px; text-align: center; color: var(--muted); }

        [hidden] { display: none !important; }
        /* The kit's tones, tuned to the report's surfaces (the kit's own CSS is inserted first) */
        body.iso {
            --anatomy-weight: .8px;
            --anatomy-paper: #141920; --anatomy-face: #1a2029; --anatomy-top: #1f2630;
            --anatomy-shade-0: #0e1217; --anatomy-shade-1: #12171d; --anatomy-shade-2: #161c24; --anatomy-shade-3: #1b222b;
            --anatomy-lit-top: #2b3542; --anatomy-lit-shade: #212934;
            --anatomy-hi: #b9c4d2; --anatomy-mid: #6d7888; --anatomy-lo: #3f4856; --anatomy-faint: #2a313b; --anatomy-lit: #ffffff;
            --anatomy-halo: #000000; --anatomy-halo-opacity: .75; --anatomy-dot: #cfd6df;
        }
        body.iso[data-theme="light"] {
            --anatomy-paper: #fbfbfa; --anatomy-face: #ffffff; --anatomy-top: #ffffff;
            --anatomy-shade-0: #d6d6d2; --anatomy-shade-1: #e1e1dd; --anatomy-shade-2: #eaeae6; --anatomy-shade-3: #f3f3f0;
            --anatomy-lit-top: #ffffff; --anatomy-lit-shade: #ededea;
            --anatomy-hi: #2a2c31; --anatomy-mid: #85888f; --anatomy-lo: #b1b3b8; --anatomy-faint: #d2d3d6; --anatomy-lit: #000000;
            --anatomy-halo: #8a8a80; --anatomy-halo-opacity: .3; --anatomy-dot: #3a3a3e;
        }
        #iso-svg .iso-solid { transition: opacity .3s; }
        #iso-svg .pl-label { font-family: var(--mono); fill: var(--muted); letter-spacing: .06em; text-transform: uppercase; }
        #iso-svg .pl-label.major { fill: var(--text); }
        #iso-svg .screw { fill: var(--anatomy-paper); stroke: var(--anatomy-mid); stroke-width: .5; }
        #iso-svg .node { cursor: pointer; }
        #iso-svg .node .iso-edge { transition: stroke .2s; }
        #iso-svg .node:hover .iso-edge, #iso-svg .node.on .iso-edge { stroke: var(--anatomy-lit); }
        #iso-svg .node.sel .iso-top { fill: color-mix(in srgb, var(--accent) 24%, var(--anatomy-top)); }
        #iso-svg .led { stroke: none; fill: var(--anatomy-lo); }
        #iso-svg .led.exposed { fill: var(--f-exposure); }
        #iso-svg .exposed-ring { fill: none; stroke: var(--f-exposure); stroke-width: .9; stroke-dasharray: 1.5 2.5; opacity: .85; }
        #iso-svg .mast { stroke: var(--anatomy-mid); stroke-width: .8; fill: none; }
        #iso-svg .beacon .iso-top, #iso-svg .beacon .iso-shade { fill: var(--sev); }
        #iso-svg .beacon .iso-fill { fill: color-mix(in srgb, var(--sev) 55%, var(--anatomy-paper)); }
        #iso-svg .beacon-halo { fill: var(--sev); opacity: .0; }
        #iso-svg .beacon-halo.pulse { animation: halo 2.4s cubic-bezier(.32,.72,0,1) infinite; transform-box: fill-box; transform-origin: center; }
        @keyframes halo { 0% { opacity: .55; transform: scale(.4); } 70% { opacity: 0; transform: scale(2.6); } 100% { opacity: 0; transform: scale(2.6); } }
        #iso-svg .node-label { font-family: var(--sans); font-size: 11px; fill: var(--strong); paint-order: stroke; stroke: var(--bg); stroke-width: 3.5px; stroke-linejoin: round; pointer-events: none; }
        #iso-svg .node-label tspan { fill: var(--muted); font-family: var(--mono); font-size: 9px; }
        .trace { --fam: var(--f-network); }
        .trace.f-exposure { --fam: var(--f-exposure); } .trace.f-identity { --fam: var(--f-identity); } .trace.f-data { --fam: var(--f-data); } .trace.f-governance { --fam: var(--f-governance); }
        #iso-svg .trace-line { fill: none; stroke: var(--fam); stroke-width: 1; stroke-linejoin: round; stroke-linecap: round; opacity: .5; transition: opacity .25s, stroke-width .25s; }
        #iso-svg .trace-flow { fill: none; stroke: var(--fam); stroke-width: 1.6; stroke-linecap: round; stroke-dasharray: 1.2 11; opacity: 0; transition: opacity .4s; }
        #iso-svg.flowing .trace-flow { opacity: .8; animation: flow 1.6s linear infinite; }
        @keyframes flow { to { stroke-dashoffset: -24.4; } }
        #iso-svg .trace-hit { fill: none; stroke: transparent; stroke-width: 9; cursor: pointer; pointer-events: stroke; }
        #iso-svg .trace-end { fill: var(--anatomy-paper); stroke: var(--fam); stroke-width: .9; }
        #iso-svg .trace-end.to { fill: var(--fam); }
        #iso-svg .trace:hover .trace-line, #iso-svg .trace.on .trace-line { opacity: 1; stroke-width: 2; }
        #iso-svg.focus .trace:not(.on) { opacity: .08; }
        #iso-svg.focus .node:not(.on):not(.sel) { opacity: .28; }
        #iso-svg.focus .beacon-group:not(.on) { opacity: .2; }
        #iso-svg .pulse-dot { fill: var(--fam); stroke: var(--bg); stroke-width: 1; pointer-events: none; }
        #iso-svg .hidden-family { display: none; }
        #iso-svg .internet .iso-edge { stroke: var(--f-exposure); }
        #iso-svg .post .iso-edge { stroke: var(--anatomy-lo); }
        #iso-svg .rise-in { opacity: 0; transform: translateY(26px); }
        #iso-svg .risen { opacity: 1; transform: none; transition: opacity .55s ease-out, transform .75s cubic-bezier(.2,.9,.25,1.12); }

        .inspector { border-left: 1px solid var(--line); background: var(--surface-2); padding: 16px; overflow-y: auto; max-height: clamp(460px, 72vh, 800px); display: flex; flex-direction: column; gap: 14px; }
        .inspector h4 { font-size: 15px; color: var(--strong); word-break: break-word; }
        .inspector .sub { font-family: var(--mono); font-size: 11px; color: var(--muted); letter-spacing: .04em; }
        .kv { display: grid; grid-template-columns: 84px minmax(0, 1fr); gap: 6px 10px; font-size: 12.5px; }
        .kv .k { color: var(--muted); }
        .kv .v { color: var(--text); word-break: break-all; }
        .conn { display: flex; flex-direction: column; gap: 4px; }
        .conn-item { display: grid; grid-template-columns: 10px minmax(0, 1fr); gap: 8px; align-items: center; padding: 7px 9px; border-radius: var(--radius-sm); border: 1px solid var(--line); background: var(--surface); cursor: pointer; font-size: 12px; text-align: left; width: 100%; }
        .conn-item:hover, .conn-item.on { border-color: var(--fam); }
        .conn-item i { width: 10px; height: 2px; border-radius: 2px; background: var(--fam); }
        .conn-item .a { color: var(--strong); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .conn-item .b { color: var(--muted); font-family: var(--mono); font-size: 10.5px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .hint { font-size: 12px; color: var(--muted); }
        .kbd { font-family: var(--mono); font-size: 10.5px; padding: 1px 5px; border: 1px solid var(--line-strong); border-radius: 4px; color: var(--text); }
        .legend { display: flex; flex-wrap: wrap; gap: 8px 22px; padding: 14px 16px; border-top: 1px solid var(--line); font-size: 12px; color: var(--muted); align-items: center; }
        .legend .key { display: inline-flex; align-items: center; gap: 7px; }
        .legend svg { width: 22px; height: 16px; }
        .caption { padding: 0 16px 16px; font-size: 12.5px; color: var(--muted); max-width: 110ch; }

        /* ── Tables ── */
        .toolbar { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 12px; align-items: center; }
        .toolbar select, .toolbar input { height: 34px; padding: 0 10px; border-radius: var(--radius-sm); border: 1px solid var(--line-strong); background: var(--surface); color: var(--strong); font-size: 13px; }
        .toolbar input { flex: 1; min-width: 200px; }
        .toolbar .result { font-family: var(--mono); font-size: 12px; color: var(--muted); }
        .table-wrap { background: var(--surface); border-radius: var(--radius); box-shadow: var(--shadow); overflow: auto; }
        table { width: 100%; border-collapse: collapse; }
        th { text-align: left; padding: 11px 14px; font-family: var(--mono); font-size: 10.5px; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); font-weight: 500; border-bottom: 1px solid var(--line); background: var(--surface-2); position: sticky; top: 0; white-space: nowrap; }
        td { padding: 11px 14px; border-bottom: 1px solid var(--line); font-size: 13px; vertical-align: top; }
        tbody tr { cursor: pointer; transition: background .12s; }
        tbody tr:hover { background: var(--surface-2); }
        td code { font-size: 11.5px; color: var(--muted); word-break: break-all; }
        td .ttl { color: var(--strong); font-weight: 550; }
        .severity-badge { display: inline-flex; align-items: center; gap: 6px; height: 22px; padding: 0 9px; border-radius: 999px; font-size: 11px; font-weight: 650; letter-spacing: .04em; color: var(--sev); background: color-mix(in srgb, var(--sev) 13%, transparent); border: 1px solid color-mix(in srgb, var(--sev) 30%, transparent); white-space: nowrap; }
        .severity-badge::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: var(--sev); }
        .severity-CRITICAL { --sev: var(--critical); } .severity-HIGH { --sev: var(--high); } .severity-MEDIUM { --sev: var(--medium); } .severity-LOW { --sev: var(--low); } .severity-INFO { --sev: var(--info); }
        .score { font-family: var(--mono); font-variant-numeric: tabular-nums; }
        .tag { display: inline-flex; height: 20px; align-items: center; padding: 0 7px; border-radius: 4px; background: var(--surface-3); color: var(--muted); font-size: 11px; font-family: var(--mono); }
        .tag.exposed { color: var(--critical); background: color-mix(in srgb, var(--critical) 12%, transparent); }
        .empty { padding: 34px 20px; display: grid; justify-items: center; gap: 10px; text-align: center; color: var(--muted); }
        .empty .figure { width: 260px; max-width: 80%; }
        .empty h4 { color: var(--strong); font-size: 15px; }

        /* ── Charts and compliance ── */
        .charts-row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; margin-bottom: 18px; }
        .chart-card { background: var(--surface); border-radius: var(--radius); box-shadow: var(--shadow); padding: 18px 20px; min-width: 0; }
        .chart-card h3 { font-size: 13px; font-weight: 600; color: var(--strong); margin-bottom: 14px; display: flex; justify-content: space-between; }
        .chart-card h3 span { font-family: var(--mono); font-size: 11px; color: var(--muted); font-weight: 400; }
        .chart-box { position: relative; height: 280px; }
        .compliance-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 14px; }
        .compliance-card { background: var(--surface); border-radius: var(--radius); box-shadow: var(--shadow); padding: 18px; display: flex; flex-direction: column; gap: 10px; }
        .compliance-card h4 { font-size: 14px; color: var(--strong); word-break: break-word; }
        .compliance-card .pct { font-size: 26px; font-weight: 700; color: var(--strong); font-variant-numeric: tabular-nums; letter-spacing: -.02em; }
        .compliance-stats { display: flex; justify-content: space-between; color: var(--muted); font-size: 12px; font-family: var(--mono); }
        .compliance-bar { height: 6px; background: color-mix(in srgb, var(--fail) 35%, var(--surface-3)); border-radius: 999px; overflow: hidden; }
        .compliance-bar-fill { height: 100%; border-radius: 999px; background: var(--pass); transition: width 1s cubic-bezier(.32,.72,0,1); }

        /* ── Detail drawer ── */
        .scrim { position: fixed; inset: 0; background: rgba(0,0,0,.4); opacity: 0; pointer-events: none; transition: opacity .25s; z-index: 90; }
        .scrim.open { opacity: 1; pointer-events: auto; }
        .detail-panel { position: fixed; top: 0; right: 0; width: min(560px, 100%); height: 100vh; background: var(--surface); border-left: 1px solid var(--line); z-index: 100; transform: translateX(100%); transition: transform .35s cubic-bezier(.32,.72,0,1); overflow-y: auto; padding: 28px; box-shadow: -30px 0 60px -30px rgba(0,0,0,.5); }
        .detail-panel.open { transform: none; }
        .detail-panel h2 { font-size: 19px; line-height: 1.3; color: var(--strong); margin: 10px 0 20px; padding-right: 30px; }
        .detail-field { margin-bottom: 16px; }
        .detail-field .label { font-family: var(--mono); font-size: 10.5px; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); margin-bottom: 5px; }
        .detail-field .value { font-size: 13.5px; color: var(--text); word-break: break-word; }
        .detail-field pre { background: var(--surface-3); border: 1px solid var(--line); padding: 12px; border-radius: var(--radius-sm); font-size: 12px; white-space: pre-wrap; word-break: break-all; max-height: 280px; overflow: auto; }
        .close-btn { position: absolute; top: 18px; right: 18px; width: 32px; height: 32px; border-radius: var(--radius-sm); background: var(--surface-2); border: 1px solid var(--line-strong); color: var(--text); font-size: 18px; cursor: pointer; }

        footer { margin-top: 40px; padding-top: 18px; border-top: 1px solid var(--line); display: flex; flex-wrap: wrap; justify-content: space-between; gap: 10px; font-size: 12px; color: var(--muted); }

        @media (max-width: 1100px) {
            .overview { grid-template-columns: 1fr; }
            .map-body { grid-template-columns: 1fr; }
            .inspector { border-left: 0; border-top: 1px solid var(--line); max-height: none; }
            .charts-row { grid-template-columns: 1fr; }
        }
        @media (max-width: 640px) {
            .topbar { padding: 10px 16px; gap: 8px; }
            .brand small, .brand .sep, .topbar .hide-sm { display: none; }
            .page { padding: 18px 16px 48px; }
            .hero { padding: 20px; }
            .hero h1 { font-size: 24px; }
            .kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); }
            .stage { height: 440px; }
            .search input { width: 100%; }
            .search { flex: 1 1 100%; }
            .corner.br { max-width: 90%; }
            .corner.tr, .corner.bl { display: none; }
        }
        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after { animation: none !important; transition: none !important; }
        }
        @media print {
            :root { --bg: #fff; --surface: #fff; --surface-2: #fff; --text: #222; --strong: #000; --muted: #555; --line: #ddd; }
            .topbar, .tabs, .plate-bar, .families, .inspector, .detail-panel, .scrim, .toolbar .btn { display: none !important; }
            .tab-content { display: block !important; break-inside: avoid; margin-bottom: 24px; }
            .card, .plate, .table-wrap, .chart-card, .compliance-card { box-shadow: 0 0 0 1px #ddd; }
            .map-body { grid-template-columns: 1fr; }
            .stage { height: 560px; }
        }
    </style>
{% if inline_js %}
    <!-- Chart.js 4.4.0 (MIT) and D3 7.9.0 (ISC), inlined so the report works offline.
         Licences: cloudg/templates/vendor/NOTICE in the cloudg package. -->
    <script>
{{ vendored_js.chartjs|safe }}
    </script>
    <script>
{{ vendored_js.d3|safe }}
    </script>
{% else %}
    <!-- Chart.js 4.4.0 and D3 7.9.0 from the CDN (report.inline_js: false) -->
    <script src="{{ cdn_js.chartjs.cdn }}" integrity="{{ cdn_js.chartjs.integrity }}" crossorigin="anonymous"></script>
    <script src="{{ cdn_js.d3.cdn }}" integrity="{{ cdn_js.d3.integrity }}" crossorigin="anonymous"></script>
{% endif %}
{% if map_js %}
    <!-- The isometric map's engines, Anatomy iso-kit (MIT) and the Hairline kernel (MIT),
         and cloudg's empty-state figure. Licences: cloudg/templates/vendor/NOTICE. -->
    <script>
{{ map_js.isokit|safe }}
    </script>
    <script>
{{ map_js.hairline|safe }}
    </script>
    <script>
{{ map_js.figures|safe }}
    </script>
{% endif %}
</head>
<body class="iso">

<header class="topbar">
    <div class="brand">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 2.5 21 7.5v9L12 21.5 3 16.5v-9z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><path d="M3 7.5 12 12.5l9-5M12 12.5v9" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" opacity=".55"/><circle cx="12" cy="12.5" r="1.8" fill="var(--accent)"/></svg>
        <span>cloudg</span><span class="sep"></span><small>Security report</small>
    </div>
    <div class="spacer"></div>
    <button class="btn icon" id="theme-toggle" type="button" title="Switch between light and dark" aria-label="Switch between light and dark">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="4.2"/><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6"/></svg>
    </button>
    <button class="btn hide-sm" type="button" id="print-btn">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M7 9V3.5h10V9M7 17H4.5V9.5h15V17H17M7 14h10v6.5H7z"/></svg>Print
    </button>
    <button class="btn hide-sm" type="button" id="csv-btn">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 3.5v11m0 0-4-4m4 4 4-4M4.5 15.5v4h15v-4"/></svg>CSV
    </button>
    <button class="btn primary" type="button" id="json-btn" onclick="exportJSON()">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3.5v11m0 0-4-4m4 4 4-4M4.5 15.5v4h15v-4"/></svg>Export JSON
    </button>
</header>

<main class="page">
    <section class="overview">
        <div class="card hero">
            <div>
                <div class="eyebrow">Security report · {{ provider }}</div>
                <h1>Estate posture</h1>
            </div>
            <p class="lede" id="lede">{{ total_findings }} findings across {{ total_assets }} assets.</p>
            <div class="meta">
                <span class="chip">Scan <b class="mono">{{ scan_id }}</b></span>
                <span class="chip">Account: {{ account_id }}</span>
                {% if summary.providers %}<span class="chip">Providers <b>{{ summary.providers|join(', ') }}</b></span>{% endif %}
                {% if summary.regions %}<span class="chip">Regions <b>{{ summary.regions|length }}</b></span>{% endif %}
                <span class="chip">Started <b>{{ started_at }}</b></span>
            </div>
            <div class="kpis">
                <div class="kpi"><div class="k">Assets</div><div class="v">{{ total_assets }}</div><div class="s">{{ summary.edges }} relations</div></div>
                <div class="kpi"><div class="k">Findings</div><div class="v">{{ total_findings }}</div><div class="s">{{ source_tools|length }} sources</div></div>
                <div class="kpi"><div class="k"><span class="dot sev-CRITICAL"></span>Critical</div><div class="v">{{ severity_counts.CRITICAL }}</div><div class="s">High {{ severity_counts.HIGH }}</div></div>
                <div class="kpi"><div class="k"><span class="dot" style="background:var(--f-exposure)"></span>Exposed</div><div class="v">{{ summary.exposed }}</div><div class="s">reachable from the internet</div></div>
            </div>
            <div>
                <div class="sevbar" id="sevbar" role="img" aria-label="Findings by severity"></div>
                <div class="sevlegend" id="sevlegend"></div>
            </div>
        </div>
        <div class="card posture">
            <div class="posture-head">
                <svg class="ring" viewBox="0 0 100 100" role="img" aria-label="Share of assets with no open findings">
                    <circle class="track" cx="50" cy="50" r="40"/>
                    <circle class="val" id="ring-val" cx="50" cy="50" r="40" stroke-dasharray="251.3" stroke-dashoffset="251.3"/>
                    <text x="50" y="57" id="ring-text">0%</text>
                </svg>
                <div>
                    <h3>Assets with no open findings</h3>
                    <p>{{ summary.clean }} of {{ total_assets }} assets have nothing open against them. The rest carry at least one finding.</p>
                </div>
            </div>
            <div>
                <div class="eyebrow" style="margin-bottom:8px">Top risks</div>
                <ul class="risks" id="top-risks"></ul>
            </div>
        </div>
    </section>

    <nav class="tabs" id="main-tabs" role="tablist">
        <button class="tab active" role="tab" data-tab="topology" type="button">Estate map</button>
        <button class="tab" role="tab" data-tab="findings" type="button">Findings <span class="count">{{ total_findings }}</span></button>
        <button class="tab" role="tab" data-tab="assets" type="button">Assets <span class="count">{{ total_assets }}</span></button>
        <button class="tab" role="tab" data-tab="charts" type="button">Analytics</button>
        <button class="tab" role="tab" data-tab="compliance" type="button">Compliance</button>
    </nav>

    <!-- Tab: Map -->
    <section class="tab-content active" id="tab-topology">
        <figure class="plate">
            <div class="plate-bar">
                <div class="seg" role="group" aria-label="Map view">
                    <button type="button" id="view-3d" aria-pressed="true">3D</button>
                    <button type="button" id="view-2d" aria-pressed="false">2D</button>
                </div>
                <div class="seg" role="group" aria-label="2D layout" id="layout-2d" hidden>
                    <button type="button" id="layout-tree" aria-pressed="true">Tree</button>
                    <button type="button" id="layout-force" aria-pressed="false">Force</button>
                </div>
                <button class="btn icon" type="button" id="rot-left" title="Turn left ( [ )" aria-label="Turn the map left"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4.5 9.5A8 8 0 1 1 5 15M4.5 4.5v5h5"/></svg></button>
                <button class="btn icon" type="button" id="rot-right" title="Turn right ( ] )" aria-label="Turn the map right"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M19.5 9.5A8 8 0 1 0 19 15M19.5 4.5v5h-5"/></svg></button>
                <button class="btn icon" type="button" id="zoom-out" title="Zoom out ( - )" aria-label="Zoom out"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 12h14"/></svg></button>
                <button class="btn icon" type="button" id="zoom-fit" title="Fit ( 0 )" aria-label="Fit the map"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 9V4h5M15 4h5v5M20 15v5h-5M9 20H4v-5"/></svg></button>
                <button class="btn icon" type="button" id="zoom-in" title="Zoom in ( + )" aria-label="Zoom in"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 12h14M12 5v14"/></svg></button>
                <button class="btn" type="button" id="labels-btn" aria-pressed="false">Labels</button>
                <button class="btn" type="button" id="trace-internet">Trace from internet</button>
                <button class="btn" type="button" id="replay-btn">Replay</button>
                <span class="grow"></span>
                <label class="search"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4 4"/></svg><input id="map-search" type="search" placeholder="Find an asset" list="map-assets" autocomplete="off"><datalist id="map-assets"></datalist></label>
            </div>
            <div class="families" id="families"></div>
            <div class="map-body">
                <div class="stage" id="stage" tabindex="0" aria-label="Isometric map of the estate. Arrow keys move the selection, [ and ] turn the map, plus and minus zoom, Escape clears.">
                    <span class="corner tl">Fig 1</span>
                    <span class="corner tr">Estate map</span>
                    <span class="corner bl" id="map-hint">Drag to pan · scroll to zoom · click an asset</span>
                    <span class="corner br" id="readout">rest</span>
                    <svg id="iso-svg" role="img" aria-label="Isometric estate map"></svg>
                    <div id="topology-container"></div>
                </div>
                <aside class="inspector" id="inspector"></aside>
            </div>
            <div class="legend" id="legend"></div>
            <figcaption class="caption" id="caption">Each provider is a base plate. Accounts and regions stand on it as platforms, networks as slabs and subnets as tiles; every asset stands where it was found. Identity and governance assets sit on the control deck behind and above the plate. Trace lines follow each relation from its source port to its target port on a lane of their own, and a beacon above an asset shows its worst open finding.</figcaption>
        </figure>
    </section>

    <!-- Tab: Findings -->
    <section class="tab-content" id="tab-findings">
        <div class="toolbar">
            <select id="filter-severity" aria-label="Severity">
                <option value="">All severities</option>
                <option value="CRITICAL">Critical</option>
                <option value="HIGH">High</option>
                <option value="MEDIUM">Medium</option>
                <option value="LOW">Low</option>
                <option value="INFO">Info</option>
            </select>
            <select id="filter-source" aria-label="Source">
                <option value="">All sources</option>
            </select>
            <input type="search" id="filter-search" placeholder="Search titles, resources and descriptions">
            <span class="result" id="findings-count"></span>
        </div>
        <div class="table-wrap">
            <table>
                <thead>
                    <tr><th>Severity</th><th>Finding</th><th>Resource</th><th>Source</th><th>Risk</th></tr>
                </thead>
                <tbody id="findings-body"></tbody>
            </table>
            <div class="empty" id="findings-empty" hidden>
                <div class="figure" id="findings-empty-figure" data-hairline></div>
                <h4>No findings</h4>
                <p>Nothing in this result set matches. Clear the filters, or run <code>cloudg scan</code> to add scanner results.</p>
            </div>
        </div>
    </section>

    <!-- Tab: Assets -->
    <section class="tab-content" id="tab-assets">
        <div class="toolbar">
            <select id="asset-provider" aria-label="Provider"><option value="">All providers</option></select>
            <input type="search" id="asset-search" placeholder="Search names, types, regions and identifiers">
            <span class="result" id="assets-count"></span>
        </div>
        <div class="table-wrap">
            <table>
                <thead>
                    <tr><th>Asset</th><th>Type</th><th>Provider</th><th>Region</th><th>Findings</th></tr>
                </thead>
                <tbody id="assets-body"></tbody>
            </table>
        </div>
    </section>

    <!-- Tab: Charts -->
    <section class="tab-content" id="tab-charts">
        <div class="charts-row">
            <div class="chart-card"><h3>Severity distribution <span>{{ total_findings }} findings</span></h3><div class="chart-box"><canvas id="chart-severity"></canvas></div></div>
            <div class="chart-card"><h3>Resource types <span>top 12</span></h3><div class="chart-box"><canvas id="chart-resources"></canvas></div></div>
        </div>
        <div class="charts-row">
            <div class="chart-card"><h3>Findings by source <span>{{ source_tools|length }} sources</span></h3><div class="chart-box"><canvas id="chart-sources"></canvas></div></div>
            <div class="chart-card"><h3>Compliance overview <span>pass and fail</span></h3><div class="chart-box"><canvas id="chart-compliance"></canvas></div></div>
        </div>
    </section>

    <!-- Tab: Compliance -->
    <section class="tab-content" id="tab-compliance">
        <div class="compliance-grid" id="compliance-grid"></div>
        <div class="empty card" id="compliance-empty" hidden>
            <div class="figure" id="compliance-empty-figure" data-hairline></div>
            <h4>No compliance results</h4>
            <p>Compliance results come from scanners that map their checks to frameworks.</p>
        </div>
    </section>

    <footer>
        <span>Generated by cloudg {{ summary.version }} · scan {{ scan_id }}</span>
        <span>Map drawn with Anatomy and Hairline (MIT) · charts by Chart.js (MIT) and D3 (ISC)</span>
    </footer>
</main>

<div class="scrim" id="scrim"></div>
<div class="detail-panel" id="detail-panel" role="dialog" aria-modal="true" aria-label="Finding details">
    <button class="close-btn" type="button" onclick="closeDetail()" aria-label="Close">&times;</button>
    <div id="detail-content"></div>
</div>

<script>
    // ── Data ──
    const graphData = {{ graph_json|safe }};
    const hierarchyData = {{ hierarchy_json|safe }};
    const findingsData = {{ findings_json|safe }};
    const assetsData = {{ assets_json|safe }};
    const findingsPerResource = {{ findings_per_resource_json|safe }};
    const severityCounts = {{ severity_counts_json|safe }};
    const resourceTypes = {{ resource_types_json|safe }};
    const sourceTools = {{ source_tools_json|safe }};
    const complianceSummary = {{ compliance_summary_json|safe }};
    const reportSummary = {{ summary_json|safe }};
    const topRisks = {{ top_risks_json|safe }};
    const isoScene = {{ scene_json|safe }};

    let currentLayout = 'tree'; // 'tree' or 'force'

    // ── Tab Switching ──
    function switchTab(tabId) {
        document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
        document.querySelectorAll('.tab').forEach(el => el.classList.toggle('active', el.dataset.tab === tabId));
        document.getElementById('tab-' + tabId).classList.add('active');
        if (tabId === 'topology') setTimeout(() => renderTopology(), 30);
        if (tabId === 'charts') setTimeout(() => renderCharts(), 30);
    }

    // ── HTML escaping ──
    // Finding, asset and compliance values come from scanner output and
    // cloud metadata. Markup is only ever built with the html`` tag below,
    // which escapes every interpolated value. The map builds its SVG with
    // createElementNS and textContent, so it never parses markup at all.
    function escapeHtml(value) {
        if (value === null || value === undefined) return '';
        return String(value)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }
    function html(strings, ...values) {
        let out = strings[0];
        values.forEach((value, i) => {
            out += escapeHtml(value) + strings[i + 1];
        });
        return out;
    }
    const SEVERITIES = ['CRITICAL', 'HIGH', 'MEDIUM', 'LOW', 'INFO'];
    function severityClass(severity) {
        return 'severity-' + (SEVERITIES.includes(severity) ? severity : 'INFO');
    }
    function cssVar(name) {
        return getComputedStyle(document.documentElement).getPropertyValue(name).trim();
    }

    // Asset names for resource columns, by id and by ARN
    const assetById = new Map();
    assetsData.forEach(a => { assetById.set(a.id, a); if (a.arn) assetById.set(a.arn, a); });
    function assetOf(f) {
        return assetById.get(f.resource_id) || assetById.get(f.resource_arn) || null;
    }

    // ── Findings Table ──
    // Rows keep the finding's position in findingsData, so the detail panel
    // shows the right finding when the table is filtered
    const findingIndex = new Map(findingsData.map((f, i) => [f, i]));

    function renderFindings(data) {
        const tbody = document.getElementById('findings-body');
        tbody.innerHTML = data.map(f => {
            const asset = assetOf(f);
            return html`
            <tr data-index="${findingIndex.get(f)}">
                <td><span class="severity-badge ${severityClass(f.severity)}">${f.severity}</span></td>
                <td><div class="ttl">${f.title}</div></td>
                <td>${asset ? asset.name : ''}<div><code>${f.resource_arn || f.resource_id || ''}</code></div></td>
                <td><span class="tag">${f.source_tool}</span></td>
                <td><span class="score">${f.risk_score || '-'}</span></td>
            </tr>
        `;
        }).join('');
        const count = document.getElementById('findings-count');
        count.textContent = data.length + ' of ' + findingsData.length;
        const empty = document.getElementById('findings-empty');
        empty.hidden = data.length > 0;
    }

    function filterFindings() {
        const severity = document.getElementById('filter-severity').value;
        const source = document.getElementById('filter-source').value;
        const search = document.getElementById('filter-search').value.toLowerCase();
        let filtered = findingsData;
        if (severity) filtered = filtered.filter(f => f.severity === severity);
        if (source) filtered = filtered.filter(f => f.source_tool === source);
        if (search) filtered = filtered.filter(f =>
            String(f.title || '').toLowerCase().includes(search) ||
            String(f.resource_arn || '').toLowerCase().includes(search) ||
            String(f.resource_id || '').toLowerCase().includes(search) ||
            String(f.description || '').toLowerCase().includes(search)
        );
        renderFindings(filtered);
    }

    // ── Detail Panel ──
    function showDetail(index) {
        const f = findingsData[index];
        if (!f) return;
        const panel = document.getElementById('detail-panel');
        const content = document.getElementById('detail-content');
        const asset = assetOf(f);
        content.innerHTML = html`
            <span class="severity-badge ${severityClass(f.severity)}">${f.severity}</span>
            <h2>${f.title}</h2>
            <div class="detail-field"><div class="label">Resource</div><div class="value">${asset ? asset.name : ''} <code>${f.resource_arn || f.resource_id || 'N/A'}</code></div></div>
            <div class="detail-field"><div class="label">Description</div><div class="value">${f.description || 'N/A'}</div></div>
            <div class="detail-field"><div class="label">Evidence</div><div class="value"><pre>${f.evidence || 'N/A'}</pre></div></div>
            <div class="detail-field"><div class="label">Remediation</div><div class="value">${f.remediation || 'N/A'}</div></div>
            <div class="detail-field"><div class="label">Source tool</div><div class="value">${f.source_tool}</div></div>
            <div class="detail-field"><div class="label">CVSS score</div><div class="value">${f.cvss_score || 'N/A'}</div></div>
            <div class="detail-field"><div class="label">Compliance frameworks</div><div class="value">${(f.compliance_frameworks || []).join(', ') || 'N/A'}</div></div>
            <div class="detail-field"><div class="label">Risk score</div><div class="value">${f.risk_score || 'N/A'}</div></div>
        `;
        panel.classList.add('open');
        document.getElementById('scrim').classList.add('open');
    }
    function closeDetail() {
        document.getElementById('detail-panel').classList.remove('open');
        document.getElementById('scrim').classList.remove('open');
    }

    // ── Compliance Grid ──
    function renderCompliance() {
        const grid = document.getElementById('compliance-grid');
        const entries = Object.entries(complianceSummary);
        grid.innerHTML = entries.map(([fw, data]) => {
            const pass = Number(data.pass) || 0;
            const fail = Number(data.fail) || 0;
            const total = pass + fail;
            const pct = total > 0 ? Math.round((pass / total) * 100) : 0;
            return html`
                <div class="compliance-card">
                    <h4>${fw}</h4>
                    <div class="pct">${pct}%</div>
                    <div class="compliance-bar"><div class="compliance-bar-fill" style="width:${pct}%"></div></div>
                    <div class="compliance-stats"><span>${pass} pass</span><span>${fail} fail</span><span>${total} controls</span></div>
                </div>
            `;
        }).join('');
        document.getElementById('compliance-empty').hidden = entries.length > 0;
    }

    // ── Overview ──
    function renderOverview() {
        const total = SEVERITIES.reduce((n, s) => n + (severityCounts[s] || 0), 0);
        const bar = document.getElementById('sevbar');
        bar.innerHTML = SEVERITIES.filter(s => severityCounts[s]).map(s =>
            html`<span class="sev-${s}" style="flex:${severityCounts[s]}" title="${s}: ${severityCounts[s]}"></span>`).join('');
        document.getElementById('sevlegend').innerHTML = SEVERITIES.map(s =>
            html`<span><i class="dot sev-${s}"></i>${s.charAt(0) + s.slice(1).toLowerCase()} ${severityCounts[s] || 0}</span>`).join('');
        const assets = assetsData.length;
        const pct = assets ? Math.round((reportSummary.clean / assets) * 100) : 100;
        const ring = document.getElementById('ring-val');
        ring.style.strokeDashoffset = String(251.3 * (1 - pct / 100));
        if (pct < 50) ring.style.stroke = cssVar('--high');
        document.getElementById('ring-text').textContent = pct + '%';
        const worst = SEVERITIES.find(s => severityCounts[s]);
        const providers = reportSummary.providers.length;
        document.getElementById('lede').innerHTML = html`<strong>${total}</strong> findings across <strong>${assets}</strong> assets in <strong>${providers}</strong> ${providers === 1 ? 'provider' : 'providers'}. ${worst ? 'The worst open finding is ' + worst.toLowerCase() + '.' : 'Nothing is open.'} <strong>${reportSummary.exposed}</strong> ${reportSummary.exposed === 1 ? 'asset is' : 'assets are'} reachable from the internet.`;
        const list = document.getElementById('top-risks');
        list.innerHTML = topRisks.length ? topRisks.map(i => {
            const f = findingsData[i];
            const asset = assetOf(f);
            return html`<li><button class="risk" type="button" data-index="${i}"><span class="dot sev-${SEVERITIES.includes(f.severity) ? f.severity : 'INFO'}"></span><span><div class="t">${f.title}</div><div class="r">${asset ? asset.name : (f.resource_arn || f.resource_id || '')}</div></span><span class="score">${f.risk_score || ''}</span></button></li>`;
        }).join('') : html`<li class="hint">No open findings.</li>`;
    }

    // ── Assets Table ──
    function renderAssets() {
        const provider = document.getElementById('asset-provider').value;
        const search = document.getElementById('asset-search').value.toLowerCase();
        let rows = assetsData;
        if (provider) rows = rows.filter(a => a.provider === provider);
        if (search) rows = rows.filter(a => [a.name, a.asset_type, a.region, a.arn, a.id, a.account_id]
            .some(v => String(v || '').toLowerCase().includes(search)));
        const shown = rows.slice(0, 2000);
        document.getElementById('assets-body').innerHTML = shown.map(a => {
            const counts = findingsPerResource[a.id] || findingsPerResource[a.arn || ''] || null;
            const worst = counts ? SEVERITIES.find(s => counts[s]) : null;
            // Escaped fragments are joined, never nested: html`` would escape them again
            const exposed = a.is_internet_exposed ? html` <span class="tag exposed">exposed</span>` : '';
            const badge = worst ? html`<span class="severity-badge severity-${worst}">${counts.total}</span>` : html`<span class="hint">none</span>`;
            return html`<tr data-asset="${a.id}">
                <td><div class="ttl">${a.name}</div><div><code>${a.arn || a.id}</code></div></td>
                <td><span class="tag">${a.asset_type}</span>` + exposed + html`</td>
                <td>${a.provider}</td>
                <td>${a.region}</td>
                <td>` + badge + html`</td>
            </tr>`;
        }).join('');
        document.getElementById('assets-count').textContent = rows.length + ' of ' + assetsData.length + (rows.length > shown.length ? ' (first 2000 shown)' : '');
    }

    // ── Isometric map ──
    // The scene (cloudg/renderers/iso_scene.py) holds every position in world
    // units. This code projects it with the Anatomy iso-kit camera, paints it
    // back to front, and animates it. Nothing here parses markup: elements are
    // made with createElementNS and names go in with textContent.
    const SVGNS = 'http://www.w3.org/2000/svg';
    const FAMILIES = [
        ['exposure', 'Internet exposure'], ['network', 'Network path'], ['identity', 'Identity and access'],
        ['data', 'Data and invocation'], ['governance', 'Governance and protection'],
    ];
    const MAP = {
        az: 45, el: 30, P: null, view: null, base: null, labels: false,
        families: new Set(FAMILIES.map(f => f[0])), selected: null, focusTrace: null,
        traceEls: new Map(), nodeEls: new Map(), byId: new Map(), pulses: [], raf: 0,
        built: false, flat: false, turning: false,
    };
    // The drawing box: 1200 wide, as tall as the stage's aspect asks (set in buildMap)
    let W = 1200, H = 760;

    function svgEl(tag, attrs, parent) {
        const el = document.createElementNS(SVGNS, tag);
        if (attrs) for (const k in attrs) if (attrs[k] !== undefined && attrs[k] !== null && attrs[k] !== '') el.setAttribute(k, attrs[k]);
        if (parent) parent.appendChild(el);
        return el;
    }
    function reducedMotion() {
        return window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    }

    // A kit solid as DOM: halo, fill, four side tones, top, crease, bevel, edge
    function solid(parent, paths, opts) {
        const o = opts || {};
        const g = svgEl('g', { class: 'iso-solid' + (o.cls ? ' ' + o.cls : '') }, parent);
        if (o.lit) g.setAttribute('data-lit', '');
        if (o.halo) svgEl('path', { class: 'iso-halo', d: paths.fill }, g);
        svgEl('path', { class: 'iso-fill', d: paths.fill }, g);
        if (!o.flat) {
            paths.shades.forEach((d, i) => { if (d) svgEl('path', { class: 'iso-shade', 'data-shade': i, d }, g); });
            svgEl('path', { class: 'iso-top', d: paths.top }, g);
        }
        if (paths.crease) svgEl('path', { class: 'iso-line iso-crease', 'data-tone': o.crease || 'faint', d: paths.crease }, g);
        if (paths.bevel) svgEl('path', { class: 'iso-line iso-bevel', 'data-tone': o.crease || 'faint', d: paths.bevel }, g);
        if (o.inner) o.inner(g);
        svgEl('path', { class: 'iso-line iso-edge', 'data-tone': o.tone || 'hi', d: paths.outline }, g);
        return g;
    }
    function line(parent, d, tone, cls) {
        if (!d) return null;
        return svgEl('path', { class: 'iso-line' + (cls ? ' ' + cls : ''), 'data-tone': tone || 'lo', d }, parent);
    }

    // A matrix that lays text flat on a top face and keeps it reading left to right
    function faceMatrix(at, z, P) {
        const o = IsoKit.iso([at[0], at[1], z], P);
        const vx = IsoKit.iso([at[0] + 1, at[1], z], P), vy = IsoKit.iso([at[0], at[1] + 1, z], P);
        const ex = [vx[0] - o[0], vx[1] - o[1]], ey = [vy[0] - o[0], vy[1] - o[1]];
        const cands = [[ex, ey], [[-ex[0], -ex[1]], ey], [ey, ex], [[-ey[0], -ey[1]], ex]];
        let best = cands[0];
        for (const c of cands) if (c[0][0] > best[0][0]) best = c;
        let [u, v] = best;
        if (v[1] < 0) v = [-v[0], -v[1]];
        const f = n => Math.round(n * 1000) / 1000;
        return 'matrix(' + [u[0], u[1], v[0], v[1], o[0], o[1]].map(f).join(' ') + ')';
    }

    // Draw order for siblings with disjoint footprints: a before b when b is
    // nearer along the one axis that separates them (a topological sort, with
    // centre depth breaking ties), so each platform's contents paint in order.
    function orderSiblings(items, P) {
        const [vx, vy] = IsoKit.towardViewer(P);
        const n = items.length;
        if (n < 2) return items.slice();
        const depth = it => (it.cx * vx + it.cy * vy);
        if (n > 60) return items.slice().sort((a, b) => depth(a) - depth(b));
        const after = items.map(() => []), deg = new Array(n).fill(0);
        for (let i = 0; i < n; i++) for (let j = i + 1; j < n; j++) {
            const a = items[i], b = items[j];
            const sx = a.x1 <= b.x0 + 1e-6 ? 1 : (b.x1 <= a.x0 + 1e-6 ? -1 : 0);
            const sy = a.y1 <= b.y0 + 1e-6 ? 1 : (b.y1 <= a.y0 + 1e-6 ? -1 : 0);
            let aFirst = null;
            if (sx && !sy) aFirst = sx * vx > 0;
            else if (sy && !sx) aFirst = sy * vy > 0;
            if (aFirst === null) continue;
            if (aFirst) { after[i].push(j); deg[j]++; } else { after[j].push(i); deg[i]++; }
        }
        const out = [], ready = [];
        for (let i = 0; i < n; i++) if (!deg[i]) ready.push(i);
        while (ready.length) {
            ready.sort((p, q) => depth(items[q]) - depth(items[p]));
            const i = ready.pop();
            out.push(items[i]);
            for (const j of after[i]) if (!--deg[j]) ready.push(j);
        }
        if (out.length < n) return items.slice().sort((a, b) => depth(a) - depth(b));
        return out;
    }
    function rectOf(x, y, w, d) { return { x0: x, y0: y, x1: x + w, y1: y + d, cx: x + w / 2, cy: y + d / 2 }; }

    // ── Parts ──
    function drawPlatform(parent, p, P) {
        const K = IsoKit;
        const radius = { provider: 3.2, region: 2.4, network: 1.8, subnet: 1.2, zone: 1.2, deck: 2.4 }[p.kind] || 1.2;
        const plan = { x: p.x, y: p.y, w: p.w, d: p.d, r: radius };
        const g = svgEl('g', { class: 'platform pl-' + p.kind }, parent);
        if (p.kind === 'provider') {
            // Feet under the plate, and a soft halo on the bench
            for (const [fx, fy] of K.corners(plan, 7)) solid(g, K.cylinder(fx, fy, 2.6, -3, 3, P, 18), { tone: 'mid' });
        }
        const top = p.z + p.h;
        const tones = { provider: 'mid', region: 'mid', network: 'mid', subnet: 'lo', zone: 'lo', deck: 'mid' };
        solid(g, K.slabOf(plan, p.z, p.h, P, 8, p.kind === 'provider' ? 1.4 : 0.8), {
            tone: tones[p.kind] || 'lo', halo: p.kind === 'provider' || p.kind === 'deck',
            inner: s => {
                const inset = K.insetPlan(plan, Math.min(3.5, Math.min(p.w, p.d) / 6));
                line(s, K.planOutline(inset, top, P), 'faint');
                if (p.kind === 'provider' || p.kind === 'deck') {
                    // Ruler ticks along the front edge and a screw at each corner
                    const t = K.topTicks(p.x + 6, p.x + p.w - 6, 4, 5, p.y + p.d - 2.2, top, [1.0, 1.9], P, 'x');
                    line(s, t.minor, 'faint'); line(s, t.major, 'lo');
                    for (const [sx, sy] of K.corners(plan, 3.2)) {
                        const c = K.iso([sx, sy, top], P);
                        svgEl('circle', { class: 'screw', cx: c[0].toFixed(1), cy: c[1].toFixed(1), r: 1.1 }, s);
                    }
                }
                if (p.kind === 'network') line(s, K.sideSeam(plan, p.z + p.h * 0.5, P), 'faint');
            },
        });
        if (p.kind !== 'zone' && p.w > 30) {
            const label = svgEl('text', {
                class: 'pl-label' + (p.kind === 'provider' || p.kind === 'deck' ? ' major' : ''),
                transform: faceMatrix([p.x + 4.5, p.y + 3.2], top, P), 'font-size': p.kind === 'provider' ? 4.2 : 3.2,
                'dominant-baseline': 'hanging',
            }, g);
            const max = Math.max(6, Math.floor((p.w - 10) / (p.kind === 'provider' ? 2.6 : 2.0)));
            const text = p.label.length > max ? p.label.slice(0, max - 1) + '…' : p.label;
            label.textContent = text;
        }
        return g;
    }

    function drawNode(parent, n, P) {
        const K = IsoKit;
        const g = svgEl('g', { class: 'node c-' + n.category, 'data-node': n.id, tabindex: '-1' }, parent);
        const title = svgEl('title', null, g);
        title.textContent = n.name + ' · ' + n.type + (n.region ? ' · ' + n.region : '');
        const { x, y, z, w, d, h } = n;
        const plan = { x: x - w / 2, y: y - d / 2, w, d, r: 1.2 };
        const top = z + h;
        if (n.exposed) line(g, K.ring(x, y, Math.max(w, d) / 2 + 2.4, z + 0.05, P, 36), null, 'exposed-ring');
        const box = (pl, z0, hh, opt) => solid(g, K.slabOf(pl, z0, hh, P, 6, 0.5), opt || {});
        const cyl = (r, z0, hh, steps, opt) => solid(g, K.cylinder(x, y, r, z0, hh, P, steps || 28, 0.4), opt || {});
        switch (n.shape) {
            case 'server':
                box(plan, z, h, { inner: s => {
                    for (let i = 1; i <= 3; i++) line(s, K.sideSeam(plan, z + (h * i) / 4, P), 'faint');
                    for (const dot of K.dotGrid(x - 3, y - 3, 3, 3, 3, top, P)) svgEl('circle', { class: 'iso-dot-vent', cx: dot[0].toFixed(1), cy: dot[1].toFixed(1), r: .45, fill: 'var(--anatomy-lo)' }, s);
                } });
                break;
            case 'cluster': {
                box({ x: plan.x, y: plan.y, w, d, r: 1.4 }, z, 3);
                const q = w / 2 - 0.8;
                for (const [ox, oy] of [[-1, -1], [1, -1], [-1, 1], [1, 1]].sort((a, b) => (a[0] + a[1]) - (b[0] + b[1])))
                    box({ x: x + (ox < 0 ? -q - 0.4 : 0.4), y: y + (oy < 0 ? -q - 0.4 : 0.4), w: q, d: q, r: 0.8 }, z + 3, h - 3);
                break;
            }
            case 'function':
                box(plan, z, h, { inner: s => line(s, K.sideSeam(plan, z + h * 0.7, P), 'faint') });
                box({ x: x - w / 2 - 0.6, y: y - d / 2 - 0.6, w: w + 1.2, d: d + 1.2, r: 1 }, top, 1.2);
                break;
            case 'database':
                cyl(w / 2, z, h, 30, { inner: s => {
                    line(s, K.sideArc(x, y, w / 2, z + h / 3, P), 'faint');
                    line(s, K.sideArc(x, y, w / 2, z + (2 * h) / 3, P), 'faint');
                } });
                break;
            case 'bucket':
                cyl(w / 2 - 0.6, z, h, 30);
                line(g, K.ring(x, y, w / 2 - 2, top, P, 30), 'lo');
                break;
            case 'queue': {
                box(plan, z, h, { inner: s => {
                    for (let i = 1; i < 4; i++) line(s, K.lineOnTop([plan.x + (w * i) / 4, plan.y + 1], [plan.x + (w * i) / 4, plan.y + d - 1], top, P), 'faint');
                } });
                break;
            }
            case 'gateway':
                box(plan, z, h, { inner: s => {
                    for (const dot of K.dotGrid(x - 4, y, 3, 1, 4, top, P)) svgEl('circle', { class: 'led' + (n.exposed ? ' exposed' : ''), cx: dot[0].toFixed(1), cy: dot[1].toFixed(1), r: .9 }, s);
                } });
                break;
            case 'shield':
                cyl(w / 2, z, h, 8, { inner: s => line(s, K.ring(x, y, w / 2 - 2, top, P, 8), 'faint') });
                break;
            case 'key':
                cyl(w / 2, z, h * 0.6, 24);
                cyl(w / 4, z + h * 0.6, h * 0.4, 18);
                break;
            case 'log':
                for (let i = 0; i < 3; i++) box({ x: plan.x + i * 0.4, y: plan.y + i * 0.4, w: w - i * 0.8, d: d - i * 0.8, r: 1 }, z + i * (h / 3), h / 3 - 0.3);
                break;
            case 'core':
                cyl(w / 2, z, h * 0.7, 6);
                cyl(w / 4, z + h * 0.7, h * 0.3, 20, { lit: true });
                break;
            case 'principal':
                cyl(w / 2 - 1, z, h * 0.65, 22);
                cyl(w / 2, z + h * 0.65, h * 0.35, 22);
                break;
            case 'plate':
                box(plan, z, h, { inner: s => {
                    for (let i = 1; i <= 3; i++) line(s, K.lineOnTop([plan.x + 2.5, plan.y + (d * i) / 4.4], [plan.x + w - 2.5, plan.y + (d * i) / 4.4], top, P), 'faint');
                } });
                break;
            default:
                box(plan, z, h);
        }
        return g;
    }

    function drawBeacon(parent, n, P) {
        if (!n.worst) return null;
        const K = IsoKit;
        const rank = SEVERITIES.indexOf(n.worst);
        const mastTop = n.z + n.h + 7 + (4 - rank) * 2.6;
        const g = svgEl('g', { class: 'beacon-group sev-' + n.worst, 'data-node': n.id }, parent);
        svgEl('path', { class: 'mast', d: K.segment([n.x, n.y, n.z + n.h], [n.x, n.y, mastTop], P) }, g);
        solid(g, K.cylinder(n.x, n.y, 1.9, mastTop, 2.4, P, 18), { cls: 'beacon', tone: 'hi' });
        const c = K.iso([n.x, n.y, mastTop + 2.4], P);
        const halo = svgEl('circle', { class: 'beacon-halo' + (rank <= 1 ? ' pulse' : ''), cx: c[0].toFixed(1), cy: c[1].toFixed(1), r: 3.2 }, g);
        halo.style.animationDelay = ((n.x * 7 + n.y * 13) % 2400) + 'ms';
        return g;
    }

    function drawExternal(parent, e, P) {
        const K = IsoKit;
        const g = svgEl('g', { class: 'node external ' + (e.kind === 'internet' ? 'internet' : ''), 'data-node': e.id }, parent);
        const t = svgEl('title', null, g);
        t.textContent = e.kind === 'internet' ? 'The internet (' + e.name + ')' : 'Outside the estate: ' + e.name;
        if (e.kind === 'internet') {
            // An uplink mast: a weighted foot, a tapering column, three dish rings
            solid(g, K.cylinder(e.x, e.y, 9, 0, 3, P, 36, 0.6), { tone: 'mid', halo: true });
            solid(g, K.cylinder(e.x, e.y, 3.4, 3, e.h - 9, P, 24), { tone: 'hi' });
            for (let i = 0; i < 3; i++) line(g, K.sideArc(e.x, e.y, 3.4, 8 + i * 6, P), 'faint');
            solid(g, K.cylinder(e.x, e.y, 6.5, e.h - 6, 2, P, 32, 0.4), { tone: 'hi' });
            solid(g, K.cylinder(e.x, e.y, 2.2, e.h - 4, 4, P, 20), { tone: 'hi', lit: true });
        } else {
            solid(g, K.slabOf({ x: e.x - e.w / 2, y: e.y - e.d / 2, w: e.w, d: e.d, r: 1.4 }, 0, e.h, P, 6, 0.5), { tone: 'mid' });
        }
        return g;
    }

    function roundedPath(pts, r) {
        if (pts.length < 3) return 'M' + pts.map(p => p[0].toFixed(1) + ' ' + p[1].toFixed(1)).join('L');
        let d = 'M' + pts[0][0].toFixed(1) + ' ' + pts[0][1].toFixed(1);
        for (let i = 1; i < pts.length - 1; i++) {
            const [ax, ay] = pts[i - 1], [bx, by] = pts[i], [cx, cy] = pts[i + 1];
            const l1 = Math.hypot(bx - ax, by - ay), l2 = Math.hypot(cx - bx, cy - by);
            const rr = Math.min(r, l1 / 2, l2 / 2);
            if (rr < 0.3) { d += 'L' + bx.toFixed(1) + ' ' + by.toFixed(1); continue; }
            const p1 = [bx - ((bx - ax) / l1) * rr, by - ((by - ay) / l1) * rr];
            const p2 = [bx + ((cx - bx) / l2) * rr, by + ((cy - by) / l2) * rr];
            d += 'L' + p1[0].toFixed(1) + ' ' + p1[1].toFixed(1) + 'Q' + bx.toFixed(1) + ' ' + by.toFixed(1) + ' ' + p2[0].toFixed(1) + ' ' + p2[1].toFixed(1);
        }
        const last = pts[pts.length - 1];
        return d + 'L' + last[0].toFixed(1) + ' ' + last[1].toFixed(1);
    }

    function drawTrace(parent, t, P) {
        const g = svgEl('g', { class: 'trace f-' + t.family + (MAP.families.has(t.family) ? '' : ' hidden-family'), 'data-trace': t.id }, parent);
        const pts = t.points.map(p => IsoKit.iso(p, P)).filter((p, i, a) => i === 0 || Math.hypot(p[0] - a[i - 1][0], p[1] - a[i - 1][1]) > 0.05);
        const d = roundedPath(pts, 4);
        const title = svgEl('title', null, g);
        title.textContent = nameOf(t.source) + ' → ' + nameOf(t.target) + ' · ' + t.label + (t.ports ? ' · ' + t.ports : '');
        svgEl('path', { class: 'trace-hit', d }, g);
        const lineEl = svgEl('path', { class: 'trace-line', d }, g);
        svgEl('path', { class: 'trace-flow', d }, g);
        const a = pts[0], b = pts[pts.length - 1];
        svgEl('circle', { class: 'trace-end', cx: a[0].toFixed(1), cy: a[1].toFixed(1), r: 1.5 }, g);
        svgEl('circle', { class: 'trace-end to', cx: b[0].toFixed(1), cy: b[1].toFixed(1), r: 1.7 }, g);
        MAP.traceEls.set(t.id, { g, line: lineEl, t });
        return g;
    }

    function nameOf(id) {
        const n = MAP.byId.get(id);
        return n ? n.name : id;
    }

    // ── Build ──
    function buildMap() {
        const svg = document.getElementById('iso-svg');
        while (svg.firstChild) svg.removeChild(svg.firstChild);
        MAP.traceEls.clear(); MAP.nodeEls.clear();
        const s = isoScene;
        const b = s.bounds;
        const stageEl = document.getElementById('stage');
        const sw = stageEl.clientWidth || 1200, sh = stageEl.clientHeight || 760;
        const nextH = Math.round(W * Math.min(1.6, Math.max(0.45, sh / sw)));
        if (nextH !== H) { H = nextH; MAP.view = null; }
        const corners = [];
        for (const x of b.x) for (const y of b.y) for (const z of b.z) corners.push([x, y, z]);
        corners.push([b.x[0], b.y[0], -3]);
        const P = IsoKit.fitProjection(corners, W, H, { pad: 46, azimuth: MAP.az, elevation: MAP.el });
        MAP.P = P;
        if (!MAP.view) MAP.view = [0, 0, W, H];
        svg.setAttribute('viewBox', MAP.view.join(' '));
        svg.setAttribute('preserveAspectRatio', 'xMidYMid meet');
        svg.classList.add('iso-svg');

        const kids = new Map();
        const push = (key, item) => { if (!kids.has(key)) kids.set(key, []); kids.get(key).push(item); };
        s.platforms.forEach(p => push(p.parent || '', { kind: 'platform', p, ...rectOf(p.x, p.y, p.w, p.d) }));
        s.nodes.forEach(n => push(n.parent, { kind: 'node', n, ...rectOf(n.x - 9, n.y - 9, 18, 18) }));

        const layers = { decks: svgEl('g', { class: 'layer-decks' }), ground: svgEl('g', { class: 'layer-ground' }),
            groundTraces: svgEl('g', { class: 'layer-traces' }), deckTraces: svgEl('g', { class: 'layer-traces deck' }),
            labels: svgEl('g', { class: 'layer-labels' }) };
        const rising = [];
        const paint = (parent, item, depthIndex) => {
            if (item.kind === 'platform') {
                const p = item.p;
                const g = svgEl('g', { class: 'stack' }, parent);
                if (p.kind === 'deck') {
                    // Four posts carry the control deck above the plate
                    const posts = IsoKit.corners({ x: p.x, y: p.y, w: p.w, d: p.d }, 4).map(([px, py]) => ({ px, py, ...rectOf(px - 1, py - 1, 2, 2) }));
                    for (const post of orderSiblings(posts, P)) solid(g, IsoKit.cylinder(post.px, post.py, 1.5, 0, p.z, P, 16), { cls: 'post', tone: 'lo' });
                }
                drawPlatform(g, p, P);
                rising.push(g);
                for (const child of orderSiblings(kids.get(p.id) || [], P)) paint(g, child, depthIndex + 1);
            } else {
                const n = item.n;
                const g = drawNode(parent, n, P);
                MAP.nodeEls.set(n.id, g);
                drawBeacon(parent, n, P);
            }
        };
        const roots = orderSiblings(kids.get('') || [], P);
        for (const root of roots) paint(root.p.kind === 'deck' ? layers.decks : layers.ground, root, 0);
        const externals = s.externals.map(e => ({ e, ...rectOf(e.x - e.w, e.y - e.d, e.w * 2, e.d * 2) }));
        for (const ext of orderSiblings(externals, P)) { const g = drawExternal(layers.ground, ext.e, P); MAP.nodeEls.set(ext.e.id, g); rising.push(g); }

        const deckIds = new Set(s.nodes.filter(n => n.parent && n.parent.startsWith('d:')).map(n => n.id));
        for (const t of s.traces) drawTrace(deckIds.has(t.source) || deckIds.has(t.target) ? layers.deckTraces : layers.groundTraces, t, P);

        // The deck is behind the plate (toward -y): paint it first unless the camera looks from behind
        const deckInFront = IsoKit.towardViewer(P)[1] < 0;
        const order = deckInFront
            ? [layers.ground, layers.groundTraces, layers.decks, layers.deckTraces, layers.labels]
            : [layers.decks, layers.ground, layers.groundTraces, layers.deckTraces, layers.labels];
        order.forEach(l => svg.appendChild(l));
        MAP.layers = layers;
        MAP.rising = rising;
        renderLabels();
        applyFocus();
        MAP.built = true;
    }

    function renderLabels() {
        const layer = MAP.layers && MAP.layers.labels;
        if (!layer) return;
        while (layer.firstChild) layer.removeChild(layer.firstChild);
        const ids = new Set();
        if (MAP.labels) isoScene.nodes.forEach(n => ids.add(n.id));
        if (MAP.selected) {
            ids.add(MAP.selected);
            for (const t of isoScene.traces) if (t.source === MAP.selected || t.target === MAP.selected) { ids.add(t.source); ids.add(t.target); }
        }
        if (MAP.hover) ids.add(MAP.hover);
        // Labels are placed top to bottom; one that would overlap a placed label
        // moves up in steps, and a leader then ties it to its asset's top
        const anchors = [...ids].map(id => MAP.byId.get(id)).filter(Boolean).map(n => {
            const top = (n.z || 0) + (n.h || 0) + (n.worst ? 18 : 5);
            return { n, a: IsoKit.iso([n.x, n.y, top], MAP.P) };
        }).sort((p, q) => p.a[1] - q.a[1]);
        const placed = [];
        const hits = (r) => placed.some(q => r.x0 < q.x1 && q.x0 < r.x1 && r.y0 < q.y1 && q.y0 < r.y1);
        for (const { n, a } of anchors) {
            const name = n.name.length > 34 ? n.name.slice(0, 33) + '…' : n.name;
            const half = Math.max(name.length * 3.1, String(n.type || '').length * 2.7) + 4;
            let dy = 0, rect;
            for (let k = 0; k < 14; k++) {
                rect = { x0: a[0] - half, x1: a[0] + half, y0: a[1] - 16 - dy, y1: a[1] + 9 - dy };
                if (!hits(rect)) break;
                dy += 13;
            }
            placed.push(rect);
            if (dy) svgEl('path', { class: 'iso-line', 'data-tone': 'mid', d: 'M' + a[0].toFixed(1) + ' ' + (a[1] + 2).toFixed(1) + 'V' + (a[1] - dy + 10).toFixed(1) }, layer);
            if (dy) svgEl('circle', { cx: a[0].toFixed(1), cy: (a[1] + 2).toFixed(1), r: 1.2, fill: 'var(--anatomy-mid)' }, layer);
            const text = svgEl('text', { class: 'node-label', x: a[0].toFixed(1), y: (a[1] - 4 - dy).toFixed(1), 'text-anchor': 'middle' }, layer);
            text.appendChild(document.createTextNode(name));
            const sub = svgEl('tspan', { x: a[0].toFixed(1), dy: '11' }, text);
            sub.textContent = n.type || n.kind || '';
        }
    }

    // ── Intro: plates rise, assets settle, traces draw in, then flow ──
    function playIntro() {
        const svg = document.getElementById('iso-svg');
        svg.classList.remove('flowing');
        if (reducedMotion()) { svg.classList.add('flowing'); return; }
        const groups = MAP.rising || [];
        groups.forEach(g => { g.classList.remove('risen'); g.classList.add('rise-in'); });
        const traces = [...MAP.traceEls.values()];
        traces.forEach(({ line: l }) => {
            const len = l.getTotalLength ? l.getTotalLength() : 0;
            l.style.transition = 'none';
            l.style.strokeDasharray = len + ' ' + len;
            l.style.strokeDashoffset = String(len);
        });
        svg.getBoundingClientRect();
        const step = Math.min(70, 900 / Math.max(1, groups.length));
        groups.forEach((g, i) => setTimeout(() => { g.classList.remove('rise-in'); g.classList.add('risen'); }, 80 + i * step));
        const start = 260 + groups.length * step;
        const famDelay = { network: 0, data: 220, identity: 440, governance: 660, exposure: 880 };
        traces.forEach(({ line: l, t }, i) => {
            const delay = start + (famDelay[t.family] || 0) + (i % 12) * 30;
            setTimeout(() => {
                l.style.transition = 'stroke-dashoffset 1.1s cubic-bezier(.32,.72,0,1)';
                l.style.strokeDashoffset = '0';
            }, delay);
        });
        clearTimeout(MAP.flowTimer);
        MAP.flowTimer = setTimeout(() => {
            traces.forEach(({ line: l }) => { l.style.strokeDasharray = ''; l.style.strokeDashoffset = ''; l.style.transition = ''; });
            svg.classList.add('flowing');
        }, start + 2200);
    }

    // ── Focus: a selected asset, a traced path ──
    function connectedTraces(id) {
        return isoScene.traces.filter(t => t.source === id || t.target === id);
    }
    function applyFocus(traceIds) {
        const svg = document.getElementById('iso-svg');
        const on = new Set(), onNodes = new Set();
        if (traceIds) traceIds.forEach(id => on.add(id));
        else if (MAP.selected) connectedTraces(MAP.selected).forEach(t => on.add(t.id));
        for (const id of on) { const t = MAP.traceEls.get(id); if (t) { onNodes.add(t.t.source); onNodes.add(t.t.target); } }
        if (MAP.selected) onNodes.add(MAP.selected);
        svg.classList.toggle('focus', on.size > 0 || !!MAP.selected);
        MAP.traceEls.forEach(({ g }, id) => g.classList.toggle('on', on.has(id)));
        svg.querySelectorAll('[data-node]').forEach(el => {
            const id = el.getAttribute('data-node');
            el.classList.toggle('on', onNodes.has(id));
            el.classList.toggle('sel', id === MAP.selected);
        });
        startPulses([...on]);
    }

    // A dot runs along each lit trace from source to target, so the eye can follow it
    function startPulses(ids, hops) {
        cancelAnimationFrame(MAP.raf);
        MAP.pulses.forEach(p => p.el.remove());
        MAP.pulses = [];
        if (!ids.length || reducedMotion()) return;
        const svg = document.getElementById('iso-svg');
        ids.slice(0, 40).forEach((id, i) => {
            const t = MAP.traceEls.get(id);
            if (!t || t.g.classList.contains('hidden-family')) return;
            const el = svgEl('circle', { class: 'pulse-dot', r: 2.3 }, t.g);
            MAP.pulses.push({ el, path: t.line, len: t.line.getTotalLength(), delay: hops ? (hops.get(id) || 0) * 420 : i * 90 });
        });
        const t0 = performance.now();
        const tick = now => {
            for (const p of MAP.pulses) {
                const e = now - t0 - p.delay;
                if (e < 0) { p.el.setAttribute('opacity', '0'); continue; }
                const dur = Math.max(900, p.len * 9);
                const f = (e % (dur + 500)) / dur;
                if (f > 1) { p.el.setAttribute('opacity', '0'); continue; }
                const eased = f < .5 ? 2 * f * f : 1 - Math.pow(-2 * f + 2, 2) / 2;
                const pt = p.path.getPointAtLength(eased * p.len);
                p.el.setAttribute('cx', pt.x.toFixed(1));
                p.el.setAttribute('cy', pt.y.toFixed(1));
                p.el.setAttribute('opacity', String(Math.min(1, Math.sin(f * Math.PI) * 1.6)));
            }
            MAP.raf = requestAnimationFrame(tick);
        };
        MAP.raf = requestAnimationFrame(tick);
    }

    function selectNode(id, opts) {
        MAP.selected = id && MAP.byId.has(id) ? id : null;
        id = MAP.selected;
        MAP.focusTrace = null;
        applyFocus();
        renderLabels();
        renderInspector();
        if (id && opts && opts.center) centerOn(id);
        const n = MAP.byId.get(id);
        setReadout(n ? n.name + ' · ' + (n.type || n.kind) + ' · ' + connectedTraces(id).length + ' relations' : null);
    }

    function focusTrace(traceId) {
        const t = MAP.traceEls.get(traceId);
        if (!t) return;
        MAP.focusTrace = traceId;
        applyFocus([traceId]);
        document.querySelectorAll('.conn-item').forEach(el => el.classList.toggle('on', el.dataset.trace === traceId));
        setReadout(nameOf(t.t.source) + ' → ' + nameOf(t.t.target) + ' · ' + t.t.label);
    }

    function traceFromInternet() {
        const starts = isoScene.externals.filter(e => e.kind === 'internet').map(e => e.id);
        if (!starts.length) { setReadout('nothing in this scan is reachable from the internet'); return; }
        const out = new Map();
        isoScene.traces.forEach(t => { if (!out.has(t.source)) out.set(t.source, []); out.get(t.source).push(t); });
        const hops = new Map(), seen = new Set(starts);
        let frontier = starts.slice(), depth = 0;
        while (frontier.length && depth < 5) {
            const next = [];
            for (const id of frontier) for (const t of out.get(id) || []) {
                if (!MAP.families.has(t.family)) continue;
                if (!hops.has(t.id)) hops.set(t.id, depth);
                if (!seen.has(t.target)) { seen.add(t.target); next.push(t.target); }
            }
            frontier = next; depth++;
        }
        const maxHop = hops.size ? Math.max(...hops.values()) + 1 : 0;
        MAP.selected = null;
        applyFocus([...hops.keys()]);
        startPulses([...hops.keys()], hops);
        renderLabels();
        renderInspector({ internet: { reached: seen.size - starts.length, hops: maxHop, traces: hops.size } });
        setReadout('the internet reaches ' + (seen.size - starts.length) + ' assets in up to ' + maxHop + (maxHop === 1 ? ' hop' : ' hops'));
    }

    function setReadout(text) {
        document.getElementById('readout').textContent = text || (isoScene.nodes ? isoScene.nodes.length + ' assets · ' + isoScene.traces.length + ' traces' : 'rest');
    }

    function renderInspector(extra) {
        const box = document.getElementById('inspector');
        const n = MAP.selected ? MAP.byId.get(MAP.selected) : null;
        if (extra && extra.internet) {
            const x = extra.internet;
            box.innerHTML = html`<div><div class="eyebrow">Attack surface</div><h4>Reachable from the internet</h4></div>
                <div class="kv"><span class="k">Assets</span><span class="v">${x.reached}</span><span class="k">Hops</span><span class="v">${x.hops}</span><span class="k">Traces</span><span class="v">${x.traces}</span></div>
                <p class="hint">The lit traces start at the internet mast and follow each relation's direction, one hop after another. Click an asset to see its own connections.</p>`;
            return;
        }
        if (!n) {
            const counts = {};
            (isoScene.traces || []).forEach(t => { counts[t.family] = (counts[t.family] || 0) + 1; });
            box.innerHTML = html`<div><div class="eyebrow">Inspector</div><h4>Pick an asset</h4></div>
                <p class="hint">Click any asset to light its relations; each lit trace carries a dot from its source to its target. Click a relation in this panel to follow it alone.</p>
                <div class="kv"><span class="k">Assets</span><span class="v">${(isoScene.nodes || []).length}</span><span class="k">Platforms</span><span class="v">${(isoScene.platforms || []).length}</span><span class="k">Traces</span><span class="v">${(isoScene.traces || []).length}</span></div>
                <p class="hint"><span class="kbd">[</span> <span class="kbd">]</span> turn · <span class="kbd">+</span> <span class="kbd">-</span> zoom · <span class="kbd">0</span> fit · <span class="kbd">Esc</span> clear</p>`;
            return;
        }
        const conns = connectedTraces(n.id);
        const connItems = conns.map(t => html`
                <button class="conn-item trace f-${t.family}" type="button" data-trace="${t.id}"><i></i><span><div class="a">${t.source === n.id ? '→ ' + nameOf(t.target) : '← ' + nameOf(t.source)}</div><div class="b">${t.label}${t.ports ? ' · ' + t.ports : ''}${t.count > 1 ? ' · ×' + t.count : ''}</div></span></button>`).join('');
        const f = n.findings || {};
        const fsum = SEVERITIES.filter(s => f[s]).map(s => s.charAt(0) + s.slice(1).toLowerCase() + ' ' + f[s]).join(', ');
        box.innerHTML = html`<div><div class="sub">${n.type || n.kind}</div><h4>${n.name}</h4></div>
            <div class="kv">
                <span class="k">Provider</span><span class="v">${n.provider || ''}</span>
                <span class="k">Region</span><span class="v">${n.region || ''}</span>
                <span class="k">Account</span><span class="v">${n.account || ''}</span>
                <span class="k">Identifier</span><span class="v mono">${n.arn || n.id}</span>
                <span class="k">Exposure</span><span class="v">${n.exposed ? 'Reachable from the internet' : 'Not exposed'}</span>
                <span class="k">Findings</span><span class="v">${fsum || 'None open'}</span>
            </div>
            <div><div class="eyebrow" style="margin-bottom:8px">Relations ${conns.length}</div><div class="conn">` + connItems + html`</div></div>`;
    }

    // ── Pan, zoom, turn ──
    function setView(v) {
        MAP.view = v;
        document.getElementById('iso-svg').setAttribute('viewBox', v.map(n => n.toFixed(1)).join(' '));
    }
    function zoomBy(factor, cx, cy) {
        const [x, y, w, h] = MAP.view;
        const nw = Math.min(W * 4, Math.max(W / 14, w / factor)), nh = nw * (h / w);
        const px = cx === undefined ? x + w / 2 : cx, py = cy === undefined ? y + h / 2 : cy;
        setView([px - (px - x) * (nw / w), py - (py - y) * (nh / h), nw, nh]);
    }
    function fitView() { setView([0, 0, W, H]); }
    function centerOn(id) {
        const n = MAP.byId.get(id);
        if (!n || !MAP.P) return;
        const p = IsoKit.iso([n.x, n.y, (n.z || 0) + (n.h || 0)], MAP.P);
        const [, , w, h] = MAP.view;
        const nw = Math.min(w, W / 2.2), nh = nw * (h / w);
        animateView([p[0] - nw / 2, p[1] - nh / 2, nw, nh]);
    }
    function animateView(target) {
        if (reducedMotion()) { setView(target); return; }
        const from = MAP.view.slice(), t0 = performance.now(), dur = 520;
        const step = now => {
            const k = Math.min(1, (now - t0) / dur), e = 1 - Math.pow(1 - k, 3);
            setView(from.map((v, i) => v + (target[i] - v) * e));
            if (k < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
    }
    function turn(by) {
        if (MAP.turning) return;
        const from = MAP.az, to = MAP.az + by;
        const heavy = (isoScene.nodes || []).length > 260 || reducedMotion();
        const finish = () => { MAP.az = ((to % 360) + 360) % 360; MAP.turning = false; buildMap(); document.getElementById('iso-svg').classList.add('flowing'); };
        if (heavy) { finish(); return; }
        MAP.turning = true;
        const t0 = performance.now(), dur = 640;
        const step = now => {
            const k = Math.min(1, (now - t0) / dur), e = k < .5 ? 4 * k * k * k : 1 - Math.pow(-2 * k + 2, 3) / 2;
            MAP.az = from + (to - from) * e;
            buildMap();
            if (k < 1) requestAnimationFrame(step); else finish();
        };
        requestAnimationFrame(step);
    }

    function setFlat(flat) {
        MAP.flat = flat;
        document.getElementById('stage').classList.toggle('flat', flat);
        document.getElementById('view-3d').setAttribute('aria-pressed', String(!flat));
        document.getElementById('view-2d').setAttribute('aria-pressed', String(flat));
        document.getElementById('layout-2d').hidden = !flat;
        ['rot-left', 'rot-right', 'labels-btn', 'trace-internet', 'replay-btn'].forEach(id => { document.getElementById(id).disabled = flat; });
        renderTopology();
    }

    function renderFamilies() {
        const counts = {};
        (isoScene.traces || []).forEach(t => { counts[t.family] = (counts[t.family] || 0) + 1; });
        document.getElementById('families').innerHTML = FAMILIES.map(([key, label]) =>
            html`<button class="fam fam-${key}" type="button" data-family="${key}" aria-pressed="${MAP.families.has(key)}"><i></i>${label}<span class="n">${counts[key] || 0}</span></button>`).join('');
    }

    function renderLegend() {
        const legend = document.getElementById('legend');
        legend.innerHTML = FAMILIES.map(([key, label]) => html`<span class="key"><svg viewBox="0 0 22 16"><path d="M2 12 L8 12 L8 4 L20 4" fill="none" stroke="var(--f-${key})" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><circle cx="2" cy="12" r="1.8" fill="var(--surface)" stroke="var(--f-${key})"/><circle cx="20" cy="4" r="2" fill="var(--f-${key})"/></svg>${label}</span>`).join('')
            + SEVERITIES.slice(0, 4).map(s => html`<span class="key"><span class="dot sev-${s}"></span>${s.charAt(0) + s.slice(1).toLowerCase()} beacon</span>`).join('')
            + html`<span class="key"><svg viewBox="0 0 22 16"><ellipse cx="11" cy="9" rx="9" ry="4.5" fill="none" stroke="var(--f-exposure)" stroke-dasharray="1.5 2.5"/></svg>Internet exposed</span>`;
    }

    // ── Topology entry point: the 3D map, or the 2D tree and force views ──
    function renderTopology() {
        const container = document.getElementById('topology-container');
        const stage = document.getElementById('stage');
        const can3d = typeof IsoKit !== 'undefined' && isoScene && isoScene.nodes && !isoScene.too_large && !isoScene.error && isoScene.nodes.length > 0;
        if (!can3d && !MAP.flat) {
            MAP.flat = true;
            stage.classList.add('flat');
            document.getElementById('view-3d').disabled = true;
            document.getElementById('view-3d').setAttribute('aria-pressed', 'false');
            document.getElementById('view-2d').setAttribute('aria-pressed', 'true');
            document.getElementById('layout-2d').hidden = false;
            const hint = document.getElementById('map-hint');
            if (isoScene && isoScene.too_large) hint.textContent = 'The 3D map is drawn for up to ' + isoScene.limit + ' assets; this scan has ' + isoScene.asset_count;
            else hint.textContent = 'Scroll to zoom · drag to pan';
        }
        if (!MAP.flat) {
            if (!MAP.built) { buildMap(); setReadout(); renderInspector(); playIntro(); }
            return;
        }
        container.querySelectorAll('svg, p').forEach(s => s.remove());
        const width = container.clientWidth || 1200;
        const height = container.clientHeight || 640;

        if (!hierarchyData || !hierarchyData.children || hierarchyData.children.length === 0) {
            if (graphData.nodes && graphData.nodes.length > 0) {
                renderForceTopology(container, width, height);
            } else {
                const msg = document.createElement('p');
                msg.className = 'map-note';
                msg.textContent = 'No topology data in this scan. Run cloudg collect or cloudg map first.';
                container.appendChild(msg);
            }
            return;
        }
        if (currentLayout === 'force') renderForceTopology(container, width, height);
        else renderTreeTopology(container, width, height);
    }

    // ── 2D views (D3) ──
    const CATEGORY_COLORS = {
        account: '--accent', region: '--f-governance', vpc: '--f-network', vnet: '--f-network', subnet: '--f-network', global: '--f-data',
    };
    function typeColor(type) {
        if (CATEGORY_COLORS[type]) return cssVar(CATEGORY_COLORS[type]);
        if (type === 'SECURITY_FINDING') return cssVar('--critical');
        if (type === 'COMPLIANCE_FRAMEWORK') return cssVar('--f-governance');
        return cssVar('--muted');
    }
    let zoomBehavior, svgG;

    function renderTreeTopology(container, width, height) {
        const svg = d3.select(container).append('svg').attr('width', width).attr('height', height);
        const g = svg.append('g');
        svgG = g;
        zoomBehavior = d3.zoom().scaleExtent([0.1, 4]).on('zoom', (e) => g.attr('transform', e.transform));
        svg.call(zoomBehavior);
        const root = d3.hierarchy(hierarchyData);
        d3.tree().nodeSize([26, 230])(root);
        const yExtent = d3.extent(root.descendants(), d => d.x);
        svg.call(zoomBehavior.transform, d3.zoomIdentity.translate(80, height / 2 - (yExtent[0] + yExtent[1]) / 2));
        g.selectAll('.link').data(root.links()).join('path')
            .attr('d', d3.linkHorizontal().x(d => d.y).y(d => d.x))
            .attr('fill', 'none').attr('stroke', cssVar('--line-strong')).attr('stroke-width', 1.2);
        const node = g.selectAll('.node').data(root.descendants()).join('g')
            .attr('transform', d => `translate(${d.y},${d.x})`);
        node.append('circle')
            .attr('r', d => d.children ? 7 : 5)
            .attr('fill', d => d.children ? cssVar('--surface') : typeColor(d.data.type))
            .attr('stroke', d => {
                const f = d.data.findings;
                if (f && f.total > 0) return cssVar(f.CRITICAL ? '--critical' : f.HIGH ? '--high' : '--medium');
                if (d.data.internet_exposed) return cssVar('--f-exposure');
                return typeColor(d.data.type);
            })
            .attr('stroke-width', d => (d.data.findings && d.data.findings.total) || d.data.internet_exposed ? 2.5 : 1.4);
        node.append('text')
            .attr('x', d => d.children ? -12 : 10).attr('dy', '0.32em')
            .attr('text-anchor', d => d.children ? 'end' : 'start')
            .attr('fill', cssVar('--text')).attr('font-size', d => d.children ? '12px' : '11px')
            .attr('font-weight', d => d.children ? 600 : 400)
            .text(d => { const n = d.data.name || d.data.id || ''; return n.length > 36 ? n.slice(0, 33) + '…' : n; });
        node.filter(d => !d.children).append('text')
            .attr('x', 10).attr('dy', '1.7em').attr('fill', cssVar('--muted')).attr('font-size', '9px')
            .attr('font-family', 'ui-monospace, monospace').text(d => d.data.type);
        node.append('title').text(d => {
            let tip = `${d.data.type}: ${d.data.name || d.data.id || ''}`;
            if (d.data.arn) tip += `\nARN: ${d.data.arn}`;
            if (d.data.findings && d.data.findings.total > 0) tip += `\nFindings: ${d.data.findings.total}`;
            if (d.data.internet_exposed) tip += '\nReachable from the internet';
            return tip;
        });
    }

    function renderForceTopology(container, width, height) {
        const svg = d3.select(container).append('svg').attr('width', width).attr('height', height);
        const g = svg.append('g');
        svgG = g;
        zoomBehavior = d3.zoom().scaleExtent([0.2, 5]).on('zoom', (e) => g.attr('transform', e.transform));
        svg.call(zoomBehavior);
        if (!graphData.nodes || graphData.nodes.length === 0) return;
        const nodes = graphData.nodes.map(n => Object.assign({}, n));
        const links = graphData.links.map(l => Object.assign({}, l));
        const sim = d3.forceSimulation(nodes)
            .force('link', d3.forceLink(links).id(d => d.id).distance(80))
            .force('charge', d3.forceManyBody().strength(-180))
            .force('center', d3.forceCenter(width / 2, height / 2))
            .force('collision', d3.forceCollide().radius(22));
        const sevVar = { CRITICAL: '--critical', HIGH: '--high', MEDIUM: '--medium', LOW: '--low' };
        const link = g.append('g').selectAll('line').data(links).join('line')
            .attr('stroke', d => d.relation === 'FINDING_AFFECTS' ? cssVar(sevVar[d.severity] || '--critical')
                : d.relation === 'COMPLIANCE_GOVERNS' ? cssVar('--f-governance') : cssVar('--line-strong'))
            .attr('stroke-width', d => d.relation ? 1.4 : 1)
            .attr('stroke-dasharray', d => d.relation ? '5,3' : null);
        const node = g.append('g').selectAll('g').data(nodes).join('g')
            .call(d3.drag().on('start', dragstarted).on('drag', dragged).on('end', dragended));
        node.append('circle').attr('r', d => d.is_external ? 6 : d.type === 'SECURITY_FINDING' ? 5 : 9)
            .attr('fill', d => d.type === 'SECURITY_FINDING' ? cssVar(sevVar[d.severity] || '--critical') : typeColor(d.type))
            .attr('stroke', d => d.is_internet_exposed ? cssVar('--f-exposure') : cssVar('--surface'))
            .attr('stroke-width', d => d.is_internet_exposed ? 2.5 : 1.5);
        node.append('text').text(d => (d.name || d.id || '').slice(0, 18))
            .attr('dy', 20).attr('text-anchor', 'middle').attr('fill', cssVar('--muted')).attr('font-size', '10px');
        node.append('title').text(d => `${d.type}: ${d.name}\nRegion: ${d.region || ''}\nARN: ${d.arn || 'N/A'}`);
        sim.on('tick', () => {
            link.attr('x1', d => d.source.x).attr('y1', d => d.source.y).attr('x2', d => d.target.x).attr('y2', d => d.target.y);
            node.attr('transform', d => `translate(${d.x},${d.y})`);
        });
        function dragstarted(e, d) { if (!e.active) sim.alphaTarget(0.3).restart(); d.fx = d.x; d.fy = d.y; }
        function dragged(e, d) { d.fx = e.x; d.fy = e.y; }
        function dragended(e, d) { if (!e.active) sim.alphaTarget(0); d.fx = null; d.fy = null; }
    }

    function resetZoom() {
        if (!MAP.flat) { animateView([0, 0, W, H]); return; }
        const svg = d3.select('#topology-container svg');
        if (svg.node() && zoomBehavior) svg.transition().duration(500).call(zoomBehavior.transform, d3.zoomIdentity.translate(80, 20));
    }

    // ── Chart.js Charts ──
    let chartsBuilt = false;
    const charts = [];
    function renderCharts() {
        if (chartsBuilt || typeof Chart === 'undefined') return;
        chartsBuilt = true;
        charts.splice(0).forEach(c => c.destroy());
        const text = cssVar('--text'), muted = cssVar('--muted'), grid = cssVar('--line');
        const sev = SEVERITIES.map(s => cssVar('--' + s.toLowerCase()));
        Chart.defaults.font.family = getComputedStyle(document.body).fontFamily;
        Chart.defaults.color = muted;
        const legend = { position: 'bottom', labels: { color: text, usePointStyle: true, pointStyle: 'circle', boxWidth: 8, padding: 14 } };
        charts.push(new Chart(document.getElementById('chart-severity'), {
            type: 'doughnut',
            data: { labels: SEVERITIES, datasets: [{ data: SEVERITIES.map(s => severityCounts[s] || 0), backgroundColor: sev, borderColor: cssVar('--surface'), borderWidth: 3, hoverOffset: 6 }] },
            options: { responsive: true, maintainAspectRatio: false, plugins: { legend }, cutout: '68%' },
        }));
        const types = Object.entries(resourceTypes).sort((a, b) => b[1] - a[1]).slice(0, 12);
        charts.push(new Chart(document.getElementById('chart-resources'), {
            type: 'bar',
            data: { labels: types.map(t => t[0]), datasets: [{ data: types.map(t => t[1]), backgroundColor: cssVar('--accent'), borderRadius: 4, barThickness: 12 }] },
            options: { responsive: true, maintainAspectRatio: false, indexAxis: 'y', plugins: { legend: { display: false } },
                scales: { x: { ticks: { color: muted }, grid: { color: grid } }, y: { ticks: { color: text, font: { family: 'ui-monospace, monospace', size: 10 } }, grid: { display: false } } } },
        }));
        const fam = ['--f-network', '--f-data', '--f-identity', '--f-governance', '--accent', '--high'].map(cssVar);
        charts.push(new Chart(document.getElementById('chart-sources'), {
            type: 'doughnut',
            data: { labels: Object.keys(sourceTools), datasets: [{ data: Object.values(sourceTools), backgroundColor: fam, borderColor: cssVar('--surface'), borderWidth: 3 }] },
            options: { responsive: true, maintainAspectRatio: false, plugins: { legend }, cutout: '68%' },
        }));
        const fws = Object.keys(complianceSummary);
        charts.push(new Chart(document.getElementById('chart-compliance'), {
            type: 'bar',
            data: { labels: fws, datasets: [
                { label: 'Pass', data: fws.map(fw => complianceSummary[fw]?.pass || 0), backgroundColor: cssVar('--pass'), borderRadius: 3 },
                { label: 'Fail', data: fws.map(fw => complianceSummary[fw]?.fail || 0), backgroundColor: cssVar('--fail'), borderRadius: 3 },
            ] },
            options: { responsive: true, maintainAspectRatio: false, plugins: { legend },
                scales: { x: { ticks: { color: text }, grid: { display: false }, stacked: true }, y: { ticks: { color: muted }, grid: { color: grid }, stacked: true } } },
        }));
    }

    // ── Empty states: Hairline figures ──
    // cloudg/templates/figures/empty-tray.js is a figure in Hairline's own
    // format; this is the small host that mounts it (the stage, its svg and a
    // read-out the figure writes to) in place of Hairline's bench page.
    function mountEmptyTray(host) {
        const spec = window.HAIRLINE_FIGURES && window.HAIRLINE_FIGURES.tray;
        if (typeof HL === 'undefined' || !spec || !host || host.dataset.mounted) return;
        host.dataset.mounted = '1';
        HL.inject(document);
        const svg = HL.mk('svg', { viewBox: '0 0 400 320', 'aria-hidden': 'true' }, host);
        const read = document.createElement('span');
        read.setAttribute('data-hairline-live', '');
        host.appendChild(read);
        spec.mount({ stage: host, svg, read }, spec.range[1]);
    }

    // ── Export ──
    function exportJSON() {
        const blob = new Blob([JSON.stringify({ findings: findingsData, assets: assetsData, graph: graphData, hierarchy: hierarchyData, scene: isoScene }, null, 2)], { type: 'application/json' });
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = 'cloudg-report.json';
        a.click();
    }
    function exportCSV() {
        const cols = ['severity', 'title', 'resource_id', 'resource_arn', 'source_tool', 'risk_score', 'cvss_score', 'compliance_frameworks', 'remediation'];
        const cell = v => {
            let s = Array.isArray(v) ? v.join('; ') : (v === null || v === undefined ? '' : String(v));
            if (/^[=+\-@\t\r]/.test(s)) s = "'" + s; // keep spreadsheets from evaluating it
            return '"' + s.replace(/"/g, '""') + '"';
        };
        const rows = [cols.join(',')].concat(findingsData.map(f => cols.map(c => cell(f[c])).join(',')));
        const blob = new Blob([rows.join('\r\n')], { type: 'text/csv' });
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = 'cloudg-findings.csv';
        a.click();
    }

    // ── Init ── (tests/test_html_report.py runs the script up to this line)
    (function init() {
        const root = document.documentElement;
        let theme = null;
        try { theme = localStorage.getItem('cloudg-report-theme'); } catch (e) { theme = null; }
        if (!theme) theme = window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        root.dataset.theme = theme;
        document.body.dataset.theme = theme;

        // The kit's tones, scoped to the report's body.iso
        if (typeof IsoKit !== 'undefined') {
            const style = document.createElement('style');
            style.textContent = IsoKit.ISO_CSS;
            document.head.insertBefore(style, document.head.firstChild);
        }
        (isoScene.nodes || []).forEach(n => MAP.byId.set(n.id, n));
        (isoScene.externals || []).forEach(e => MAP.byId.set(e.id, e));

        document.getElementById('main-tabs').addEventListener('click', e => {
            const tab = e.target.closest('[data-tab]');
            if (tab) switchTab(tab.dataset.tab);
        });
        document.getElementById('theme-toggle').addEventListener('click', () => {
            const next = root.dataset.theme === 'light' ? 'dark' : 'light';
            root.dataset.theme = next; document.body.dataset.theme = next;
            try { localStorage.setItem('cloudg-report-theme', next); } catch (e) { /* private mode */ }
            if (chartsBuilt) { chartsBuilt = false; if (document.getElementById('tab-charts').classList.contains('active')) renderCharts(); }
            if (MAP.flat) renderTopology();
        });
        document.getElementById('print-btn').addEventListener('click', () => window.print());
        document.getElementById('csv-btn').addEventListener('click', exportCSV);
        document.getElementById('scrim').addEventListener('click', closeDetail);
        document.addEventListener('keydown', e => { if (e.key === 'Escape') closeDetail(); });

        document.getElementById('findings-body').addEventListener('click', (e) => {
            const row = e.target.closest('tr[data-index]');
            if (row) showDetail(Number(row.dataset.index));
        });
        document.getElementById('top-risks').addEventListener('click', e => {
            const b = e.target.closest('[data-index]');
            if (b) showDetail(Number(b.dataset.index));
        });
        ['filter-severity', 'filter-source'].forEach(id => document.getElementById(id).addEventListener('change', filterFindings));
        document.getElementById('filter-search').addEventListener('input', filterFindings);
        const sourceSelect = document.getElementById('filter-source');
        Object.keys(sourceTools).forEach(tool => {
            const opt = document.createElement('option');
            opt.value = tool; opt.textContent = tool;
            sourceSelect.appendChild(opt);
        });
        const providerSelect = document.getElementById('asset-provider');
        [...new Set(assetsData.map(a => a.provider))].sort().forEach(p => {
            const opt = document.createElement('option');
            opt.value = p; opt.textContent = p;
            providerSelect.appendChild(opt);
        });
        providerSelect.addEventListener('change', renderAssets);
        document.getElementById('asset-search').addEventListener('input', renderAssets);
        document.getElementById('assets-body').addEventListener('click', e => {
            const row = e.target.closest('tr[data-asset]');
            if (!row || !MAP.byId.has(row.dataset.asset)) return;
            switchTab('topology');
            if (MAP.flat && !document.getElementById('view-3d').disabled) setFlat(false);
            setTimeout(() => selectNode(row.dataset.asset, { center: true }), 80);
        });

        // Map controls
        const stage = document.getElementById('stage');
        const svg = document.getElementById('iso-svg');
        document.getElementById('view-3d').addEventListener('click', () => setFlat(false));
        document.getElementById('view-2d').addEventListener('click', () => setFlat(true));
        document.getElementById('layout-tree').addEventListener('click', () => { currentLayout = 'tree'; document.getElementById('layout-tree').setAttribute('aria-pressed', 'true'); document.getElementById('layout-force').setAttribute('aria-pressed', 'false'); renderTopology(); });
        document.getElementById('layout-force').addEventListener('click', () => { currentLayout = 'force'; document.getElementById('layout-tree').setAttribute('aria-pressed', 'false'); document.getElementById('layout-force').setAttribute('aria-pressed', 'true'); renderTopology(); });
        document.getElementById('rot-left').addEventListener('click', () => turn(-90));
        document.getElementById('rot-right').addEventListener('click', () => turn(90));
        document.getElementById('zoom-in').addEventListener('click', () => MAP.flat ? null : zoomBy(1.35));
        document.getElementById('zoom-out').addEventListener('click', () => MAP.flat ? null : zoomBy(1 / 1.35));
        document.getElementById('zoom-fit').addEventListener('click', resetZoom);
        document.getElementById('labels-btn').addEventListener('click', e => { MAP.labels = !MAP.labels; e.currentTarget.setAttribute('aria-pressed', String(MAP.labels)); renderLabels(); });
        document.getElementById('trace-internet').addEventListener('click', traceFromInternet);
        document.getElementById('replay-btn').addEventListener('click', () => { MAP.selected = null; applyFocus(); renderInspector(); playIntro(); });
        document.getElementById('families').addEventListener('click', e => {
            const b = e.target.closest('[data-family]');
            if (!b) return;
            const f = b.dataset.family;
            if (MAP.families.has(f)) MAP.families.delete(f); else MAP.families.add(f);
            b.setAttribute('aria-pressed', String(MAP.families.has(f)));
            MAP.traceEls.forEach(({ g, t }) => g.classList.toggle('hidden-family', !MAP.families.has(t.family)));
            applyFocus(MAP.focusTrace ? [MAP.focusTrace] : undefined);
        });
        document.getElementById('inspector').addEventListener('click', e => {
            const b = e.target.closest('[data-trace]');
            if (b) focusTrace(b.dataset.trace);
        });
        svg.addEventListener('click', e => {
            if (MAP.dragMoved) return;
            const tr = e.target.closest('[data-trace]');
            if (tr && !e.target.closest('[data-node]')) { const t = MAP.traceEls.get(tr.dataset.trace); if (t) { MAP.selected = t.t.source; renderInspector(); focusTrace(tr.dataset.trace); renderLabels(); } return; }
            const node = e.target.closest('[data-node]');
            selectNode(node ? node.getAttribute('data-node') : null);
        });
        svg.addEventListener('pointerover', e => {
            const node = e.target.closest('[data-node]');
            const id = node ? node.getAttribute('data-node') : null;
            if (id === MAP.hover) return;
            MAP.hover = id; renderLabels();
            const n = id && MAP.byId.get(id);
            if (n) setReadout(n.name + ' · ' + (n.type || n.kind)); else if (!MAP.selected) setReadout();
        });
        // Pan with a drag, zoom with the wheel about the pointer
        const toView = (cx, cy) => {
            const r = svg.getBoundingClientRect(), [x, y, w, h] = MAP.view;
            const s = Math.min(r.width / w, r.height / h);
            const ox = (r.width - w * s) / 2, oy = (r.height - h * s) / 2;
            return [x + (cx - r.left - ox) / s, y + (cy - r.top - oy) / s, s];
        };
        stage.addEventListener('wheel', e => {
            if (MAP.flat) return;
            e.preventDefault();
            const [px, py] = toView(e.clientX, e.clientY);
            zoomBy(Math.exp(-e.deltaY * 0.0015), px, py);
        }, { passive: false });
        let drag = null;
        stage.addEventListener('pointerdown', e => {
            if (MAP.flat || e.button !== 0) return;
            drag = { x: e.clientX, y: e.clientY, view: MAP.view.slice(), s: toView(e.clientX, e.clientY)[2] };
            MAP.dragMoved = false;
        });
        window.addEventListener('pointermove', e => {
            if (!drag) return;
            const dx = e.clientX - drag.x, dy = e.clientY - drag.y;
            if (!MAP.dragMoved && Math.hypot(dx, dy) < 4) return;
            MAP.dragMoved = true; stage.classList.add('dragging');
            setView([drag.view[0] - dx / drag.s, drag.view[1] - dy / drag.s, drag.view[2], drag.view[3]]);
        });
        window.addEventListener('pointerup', () => { drag = null; stage.classList.remove('dragging'); setTimeout(() => { MAP.dragMoved = false; }, 0); });
        stage.addEventListener('keydown', e => {
            if (MAP.flat) return;
            const ids = (isoScene.nodes || []).map(n => n.id);
            if (e.key === '[') turn(-90);
            else if (e.key === ']') turn(90);
            else if (e.key === '+' || e.key === '=') zoomBy(1.35);
            else if (e.key === '-') zoomBy(1 / 1.35);
            else if (e.key === '0') resetZoom();
            else if (e.key === 'Escape') selectNode(null);
            else if (e.key === 'ArrowRight' || e.key === 'ArrowLeft' || e.key === 'ArrowDown' || e.key === 'ArrowUp') {
                const i = ids.indexOf(MAP.selected), d = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? 1 : -1;
                selectNode(ids[(i + d + ids.length) % ids.length], { center: true });
            } else return;
            e.preventDefault();
        });
        const list = document.getElementById('map-assets');
        (isoScene.nodes || []).slice(0, 3000).forEach(n => { const o = document.createElement('option'); o.value = n.name; list.appendChild(o); });
        document.getElementById('map-search').addEventListener('change', e => {
            const q = e.target.value.trim().toLowerCase();
            const n = (isoScene.nodes || []).find(x => x.name.toLowerCase() === q) || (isoScene.nodes || []).find(x => x.name.toLowerCase().includes(q) || (x.arn || '').toLowerCase().includes(q));
            if (n) { if (MAP.flat) setFlat(false); selectNode(n.id, { center: true }); }
        });

        renderOverview();
        renderFindings(findingsData);
        renderAssets();
        renderCompliance();
        renderFamilies();
        renderLegend();
        renderTopology();
        mountEmptyTray(document.getElementById('findings-empty-figure'));
        mountEmptyTray(document.getElementById('compliance-empty-figure'));
    })();
</script>

